# Copy this file to .env. Values below are examples for local Docker only.
POSTGRES_DB=skopka_hello
POSTGRES_USER=skopka
POSTGRES_PASSWORD=replace-with-a-local-password

# Startup policy and Razor UI route prefix.
SKOPKA_HELLO_SELF_REGISTRATION_ENABLED=true
SKOPKA_HELLO_UI_PATH_PREFIX=/hello

# Generate with:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
SKOPKA_HELLO_JWT_SIGNING_KEY=replace-with-a-base64-encoded-32-byte-key

# Generate independently from the JWT key with the same PowerShell command.
SKOPKA_HELLO_RATE_LIMIT_KEY_V1=replace-with-another-base64-encoded-32-byte-key

# Generate independently from both keys above.
SKOPKA_HELLO_OTP_KEY_V1=replace-with-a-third-base64-encoded-32-byte-key

# Optional account-message delivery. Leave the provider ids and SMTP host
# empty to keep delivery disabled. A custom host must register the provider
# named by SKOPKA_HELLO_SMS_PROVIDER_ID.
SKOPKA_HELLO_EMAIL_PROVIDER_ID=
SKOPKA_HELLO_SMS_PROVIDER_ID=
SKOPKA_HELLO_VERIFICATION_CHANNEL=Email
SKOPKA_HELLO_ANONYMOUS_MESSAGE_QUEUE_CAPACITY=256
SKOPKA_HELLO_SMTP_PROVIDER_ID=smtp
SKOPKA_HELLO_SMTP_HOST=
SKOPKA_HELLO_SMTP_PORT=587
SKOPKA_HELLO_SMTP_ENABLE_SSL=true
SKOPKA_HELLO_SMTP_USERNAME=
SKOPKA_HELLO_SMTP_PASSWORD=
SKOPKA_HELLO_SMTP_FROM_ADDRESS=
SKOPKA_HELLO_SMTP_FROM_NAME=Skopka.Hello
SKOPKA_HELLO_SMTP_QUEUE_CAPACITY=256
