# Environment variables for local development
# Copy to .env and adjust values

# Postgres
POSTGRES_USER=authx
POSTGRES_PASSWORD=authxpass
POSTGRES_DB=authx

# Connection strings
# For Docker: host names as service names; for local dev, override as needed
CONNECTIONSTRINGS__DEFAULT=Host=localhost;Port=5432;Database=authx;Username=authx;Password=authxpass

# Redis
REDIS_CONNECTION=localhost:6379

# Admin API key (dev only)
ADMIN_API_KEY=dev-admin-key-change-me

# CORS whitelist (comma-separated)
CORS__ORIGINS=http://localhost:5173

# Feature flags
FEATURES__INTROSPECTION=false
