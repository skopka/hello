<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Skopka.Identity собирается рядом, и пока его версия не выпущена, Hello
         строится против локально упакованной. Убрать, когда Identity выйдет в
         nuget.org: источник указывает на путь, которого нет ни на одной другой
         машине. -->
    <add key="skopka-identity-local" value="..\identity\artifacts\local-webauthn" />
  </packageSources>
</configuration>
