{
  "SkopkaHello": {
    "PublicOrigin": "https://localhost:8443",
    "Jwt": {
      "CurrentVersion": "v1"
    },
    "Cookies": {
      "Secure": true
    },
    "SelfRegistration": {
      "Enabled": true
    },
    "Totp": {
      "Enabled": true,
      "Issuer": "Skopka.Hello.Sample"
    },
    "Ui": {
      "PathPrefix": "/hello",
      "Localization": {
        "Enabled": true,
        "DefaultCulture": "en"
      }
    },
    "RateLimiting": {
      "CurrentVersion": "v1"
    },
    "Verification": {
      "CurrentVersion": "v1"
    },
    "ExternalOidc": {
      "PasswordSignInEnabled": true,
      "Providers": {
        "google": {
          "Enabled": false,
          "DisplayName": "Google",
          "Authority": "https://accounts.google.com",
          "ClientId": "",
          "ClientSecret": "",
          "RequireHttpsMetadata": true,
          "Order": 10,
          "Scopes": []
        }
      }
    }
  }
}
