@page
@model ClientsModel
@{
ViewData["Title"] = Text["Admin.Clients.Title"];
ViewData["AdminSection"] = "clients";
}
<header class="admin-page-header">
    <div>
        <div class="admin-eyebrow">@Text["Admin.Common.Administration"]</div>
        <h1>@Text["Admin.Clients.Title"]</h1>
    </div>
</header>
<div asp-validation-summary="All" class="alert alert-danger" role="alert">
</div>
@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.Secret is not null)
{
    <div class="alert alert-warning" role="status">
        <strong>@Text["Admin.Clients.SecretOnce"]</strong>
        <pre>@Model.Secret</pre>
    </div>
}
@if (Model.ChallengeId is not null)
{
    <section class="card admin-card mb-4">
        <div class="card-body">
            <h2 class="h5">@Text["Admin.Clients.Verify"]</h2>
            <p>@Text["Admin.Clients." + (Model.ActionName == "rotate" ? "Rotate" : Model.ActionName == "delete" ? "Delete" : Model.ActionName == "update" ? "Update" : "Create")]: @Model.ClientId</p>
            <form method="post" asp-page-handler="Complete">
                <input type="hidden" name="challengeId" value="@Model.ChallengeId" />
                <input type="hidden" asp-for="ActionName" />
                <input type="hidden" asp-for="ClientId" />
                <input type="hidden" asp-for="DisplayName" />
                <input type="hidden" asp-for="Type" />
                <input type="hidden" asp-for="Resource" />
                <input type="hidden" asp-for="RedirectUris" />
                <input type="hidden" asp-for="PostLogoutRedirectUris" />
                <input type="hidden" asp-for="Scopes" />
                <input type="hidden" asp-for="HonorReauthenticationPrompts" />
                <input type="hidden" asp-for="ExpectedRevision" />
                <label class="form-label" asp-for="VerificationCode">@Text["Admin.Clients.Code"]</label>
                <input class="form-control mb-2" asp-for="VerificationCode" autocomplete="one-time-code" required />
                <button class="btn btn-primary" type="submit">@Text["Admin.Clients.Confirm"]</button>
                <a class="btn btn-outline-secondary" asp-page="/SkopkaHelloAdmin/Clients">@Text["Admin.Clients.Cancel"]</a>
            </form>
        </div>
    </section>
}
@if (Model.CanManage && Model.ChallengeId is null)
{
    <section class="card admin-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h5">@Text[Model.ActionName == "update" ? "Admin.Clients.EditTitle" : "Admin.Clients.CreateTitle"]</h2>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/SkopkaHelloAdmin/Clients">@Text["Admin.Clients.NewClient"]</a>
            </div>
            <form method="post" asp-page-handler="Begin" class="row g-3">
                <input type="hidden" asp-for="ActionName" />
                <input type="hidden" asp-for="ExpectedRevision" />
                <div class="col-md-4">
                    <label class="form-label" asp-for="ClientId">Client ID</label>
                    <input class="form-control" asp-for="ClientId" readonly="@(Model.ActionName == "update")" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="DisplayName">@Text["Admin.Clients.Name"]</label>
                    <input class="form-control" asp-for="DisplayName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="Type">@Text["Admin.Clients.Type"]</label>
                    <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<Skopka.Hello.AuthorizationServer.HelloAuthorizationClientType>()"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="Resource">@Text["Admin.Clients.Resource"]</label>
                    <select class="form-select" asp-for="Resource">@foreach (var value in Model.Catalog.Resources) { <option value="@value">@value</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Scopes">@Text["Admin.Clients.Scopes"]</label>
                    <textarea class="form-control" asp-for="Scopes"></textarea>
                    <small>@string.Join(", ", Model.Catalog.Scopes)</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="RedirectUris">@Text["Admin.Clients.Redirects"]</label>
                    <textarea class="form-control" asp-for="RedirectUris"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="PostLogoutRedirectUris">@Text["Admin.Clients.LogoutRedirects"]</label>
                    <textarea class="form-control" asp-for="PostLogoutRedirectUris"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="HonorReauthenticationPrompts" />
                        <label class="form-check-label" asp-for="HonorReauthenticationPrompts">@Text["Admin.Clients.Reauthentication"]</label>
                    </div>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit">@Text["Admin.Clients.SendCode"]</button>
                </div>
            </form>
        </div>
    </section>
}
<section class="card admin-card">
    <div class="card-body">
        <h2 class="h5">@Text["Admin.Clients.Title"]</h2>
        @foreach (var client in Model.Clients)
        {
            <article class="border rounded p-3 mb-2">
                <h3 class="h6">@client.DisplayName (@client.ClientId)</h3>
                <p>@client.Type · @Text[client.Ownership == "administration" ? "Admin.Clients.Managed" : "Admin.Clients.ReadOnly"] · @Text["Admin.Clients.Revision"]: @client.Revision</p>
                <p>@Text["Admin.Clients.Resource"]: @client.Resource<br />@Text["Admin.Clients.Scopes"]: @string.Join(", ", client.Scopes)<br />@Text["Admin.Clients.Redirects"]: @string.Join(", ", client.RedirectUris)<br />@Text["Admin.Clients.LogoutRedirects"]: @string.Join(", ", client.PostLogoutRedirectUris)<br />@Text["Admin.Clients.Reauthentication"]: @client.HonorReauthenticationPrompts</p>
                @if (Model.CanManage && client.Ownership == "administration")
                {
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-outline-primary btn-sm" asp-page="/SkopkaHelloAdmin/Clients" asp-route-edit="@client.ClientId">@Text["Admin.Clients.Update"]</a>
                        <form method="post" asp-page-handler="Begin">
                            <input type="hidden" name="ActionName" value="delete" />
                            <input type="hidden" name="ClientId" value="@client.ClientId" />
                            <input type="hidden" name="ExpectedRevision" value="@client.Revision" />
                            <button class="btn btn-outline-danger btn-sm" type="submit">@Text["Admin.Clients.Delete"]</button>
                        </form>
                        @if (client.Type == Skopka.Hello.AuthorizationServer.HelloAuthorizationClientType.Confidential)
                        {
                            <form method="post" asp-page-handler="Begin">
                                <input type="hidden" name="ActionName" value="rotate" />
                                <input type="hidden" name="ClientId" value="@client.ClientId" />
                                <input type="hidden" name="ExpectedRevision" value="@client.Revision" />
                                <button class="btn btn-outline-secondary btn-sm" type="submit">@Text["Admin.Clients.Rotate"]</button>
                            </form>
                        }
                    </div>
                }
            </article>
        }
    </div>
</section>
<nav aria-label="@Text["Admin.Clients.Pages"]" class="d-flex gap-2 mt-3">
    @if (Model.Offset > 0) { <a class="btn btn-outline-secondary" asp-route-offset="@(Math.Max(0, Model.Offset - 50))">@Text["Admin.Clients.Previous"]</a> }
    @if (Model.Clients.Count == 50) { <a class="btn btn-outline-secondary" asp-route-offset="@(Model.Offset + 50)">@Text["Admin.Clients.Next"]</a> }
</nav>
