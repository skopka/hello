@page
@model RolesModel
@{
    ViewData["Title"] = Text["Admin.Roles.PageTitle"];
    ViewData["AdminSection"] = "roles";
    var openRoleVisible = Model.OpenRole is { } visibleRole && Model.ShouldOpen(visibleRole.Id);
}

<div class="admin-directory">
    <header class="admin-page-header">
        <div>
            <div class="admin-eyebrow">@Text["Admin.Common.Administration"]</div>
            <h1>@Text["Admin.Roles.Title"]</h1>
            <p>@Text["Admin.Roles.Instructions"]</p>
        </div>
        <a class="btn btn-outline-primary btn-sm"
           asp-page="/SkopkaHelloAdmin/Users">
            @Text["Admin.Roles.ManageUsers"]
        </a>
    </header>

    @if (!Model.RoleManagementEnabled)
    {
        <div class="alert alert-info shadow-sm" role="status">
            @Text["Admin.Roles.ApplicationManaged"]
        </div>
    }

    @if (!openRoleVisible)
    {
        <partial name="_AdminStatus" model="@((Model.StatusMessage, Model.OutcomeMessage))" />
    }

    <div asp-validation-summary="All"
         class="alert alert-danger admin-validation"
         role="alert"></div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-8">
            <section class="card admin-card admin-filter-card h-100"
                     aria-label="@Text["Admin.Common.ApplyFilter"]">
                <div class="card-body">
                    <div class="admin-eyebrow">@Text["Admin.Common.Search"]</div>
                    <form method="get" class="row g-2 align-items-end admin-filter-form">
                        <div class="col-12 col-sm">
                            <label class="form-label small mb-1"
                                   for="admin-role-search">
                                @Text["Admin.Roles.RoleName"]
                            </label>
                            <input class="form-control form-control-sm"
                                   id="admin-role-search"
                                   asp-for="Search"
                                   autocomplete="off"
                                   placeholder="@Text["Admin.Roles.RoleName"]" />
                        </div>
                        <div class="col-12 col-sm-auto d-grid">
                            <button class="btn btn-primary btn-sm" type="submit">
                                @Text["Admin.Common.ApplyFilter"]
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        @if (Model.CanEditRoles)
        {
            <div class="col-12 col-lg-auto d-flex align-items-end">
                <button class="btn btn-primary btn-sm" type="button"
                        data-bs-toggle="modal" data-bs-target="#admin-create-role">
                    @Text["Admin.Roles.NewRole"]
                </button>
            </div>
            <div class="modal fade" id="admin-create-role" data-admin-auto-open="@(Model.ShouldOpenCreate ? "true" : null)" tabindex="-1" aria-labelledby="admin-new-role-title" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="admin-new-role-title">@Text["Admin.Roles.NewRole"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Text["Admin.Common.Close"]"></button>
                        </div>
                        <div class="modal-body">
                            <div asp-validation-summary="All" class="alert alert-danger admin-validation" role="alert"></div>
                            <form method="post"
                                    asp-page-handler="BeginAction"
                                    class="row g-2 align-items-end">
                                <input type="hidden" name="action" value="create" />
                                <partial name="_AdminListContext" model="@Model.ListContext(null)" />
                                <div class="col-12">
                                    <label class="form-label small mb-1"
                                        for="new-role-name">
                                    @Text["Admin.Common.Name"]
                                    </label>
                                    <input class="form-control form-control-sm"
                                        id="new-role-name"
                                        name="name"
                                        value="@Model.PostedValue(null, "name")"
                                        maxlength="256"
                                        required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-1"
                                        for="new-role-description">
                                    @Text["Admin.Common.Description"]
                                    </label>
                                    <input class="form-control form-control-sm"
                                        id="new-role-description"
                                        name="description"
                                        value="@Model.PostedValue(null, "description")"
                                        maxlength="1024" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-1"
                                        for="new-role-parent">
                                    @Text["Admin.Roles.ParentRoleIdOptional"]
                                    </label>
                                    <input class="form-control form-control-sm"
                                        id="new-role-parent"
                                        name="parentId"
                                        value="@Model.PostedValue(null, "parentId")"
                                        inputmode="text" />
                                </div>
                                <div class="col-12 col-sm-auto d-grid">
                                    <button class="btn btn-primary btn-sm" type="submit">
                                    @Text["Admin.Roles.Create"]
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.PendingAction is { } pending)
    {
        var pendingRoleName = Model.Roles.FirstOrDefault(role => role.Id == pending.RoleId)?.Name;
        <button type="button" class="btn btn-warning btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#admin-pending-dialog">
            @Text["Admin.Common.ConfirmAction", Text[RolesModel.GetActionTextKey(pending.Action)]]
        </button>
        <div class="modal fade" id="admin-pending-dialog" tabindex="-1" aria-labelledby="admin-pending-title" aria-hidden="true" data-admin-auto-open="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="admin-pending-title">@Text["Admin.Common.StepUp"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Text["Admin.Common.Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <section class="alert alert-warning shadow-sm"
                                aria-labelledby="admin-role-verification-title">
                            <div asp-validation-summary="All" class="alert alert-danger admin-validation" role="alert"></div>
                            <div class="admin-subtitle">
                                @(pendingRoleName ?? pending.Parameters.Name ?? pending.RoleId?.ToString()) (@pending.RoleId)
                                @if (pending.TargetUserId is { } pendingUserId)
                                {
                                    <span>· @(Model.PendingTargetLabel ?? pendingUserId.ToString("D"))</span>
                                }
                            </div>
                            <div class="admin-eyebrow">@Text["Admin.Common.StepUp"]</div>
                            <h2 class="h5" id="admin-role-verification-title">
                            @Text[RolesModel.GetActionTextKey(pending.Action)]
                            </h2>
                            <p class="small mb-3">
                            @(pending.DeliveryChannel == HelloDeliveryChannel.Authenticator
                            ? Text["Admin.Common.EnterAuthenticatorCode"]
                            : Text["Admin.Common.EnterCode",
                            pending.DeliveryChannel == HelloDeliveryChannel.Sms
                            ? Text["Field.PhoneNumber"]
                            : Text["Field.EmailAddress"]])
                            @if (pending.ExpiresAt is { } expiresAt)
                            {
                                <span>@Text["Admin.Common.ExpiresAt", expiresAt.ToLocalTime()]</span>
                            }
                            </p>

                            <form method="post"
                                    asp-page-handler="CompleteAction"
                                    class="row g-2 align-items-end">
                                <input type="hidden"
                                    name="action"
                                    value="@RolesModel.GetActionSlug(pending.Action)" />
                                <input type="hidden" name="roleId" value="@pending.RoleId" />
                                <input type="hidden"
                                    name="targetUserId"
                                    value="@pending.TargetUserId" />
                                <input type="hidden"
                                    name="challengeId"
                                    value="@pending.ChallengeId" />
                                <input type="hidden"
                                    name="expectedVersion"
                                    value="@pending.Parameters.ExpectedVersion" />
                                <input type="hidden" name="name" value="@pending.Parameters.Name" />
                                <input type="hidden"
                                    name="description"
                                    value="@pending.Parameters.Description" />
                                <input type="hidden"
                                    name="parentId"
                                    value="@pending.Parameters.ParentId" />
                                <partial name="_AdminListContext" model="@Model.ListContext(pending.RoleId ?? Model.Open)" />

                                <div class="col-12 col-sm-7">
                                    <label class="form-label small mb-1"
                                        for="admin-role-verification-code">
                                    @Text["Field.VerificationCode"]
                                    </label>
                                    <input class="form-control form-control-sm"
                                        id="admin-role-verification-code"
                                        name="verificationCode"
                                        inputmode="@(pending.DeliveryChannel == HelloDeliveryChannel.Authenticator ? "text" : "numeric")"
                                        autocomplete="one-time-code"
                                        required />
                                </div>
                                <div class="col-12 col-sm-auto">
                                    <button class="btn btn-danger btn-sm" type="submit">
                                    @Text["Admin.Common.ConfirmAction",
                                    Text[RolesModel.GetActionTextKey(pending.Action)]]
                                    </button>
                                </div>
                            </form>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.Roles.Count == 0)
    {
        <div class="alert alert-light border shadow-sm">
            @Text["Admin.Roles.None"]
        </div>
    }
    else
    {
        <section class="admin-list"
                 aria-label="@Text["Admin.Roles.Title"]">
            @foreach (var role in Model.Roles)
            {
                var editPanelId = $"admin-role-{role.Id:N}";
                var isOpen = Model.OpenRole?.Id == role.Id;

                <article class="admin-list-row admin-role-card">
                    <div class="admin-row-content">
                        <h2 class="admin-role-title">@role.Name</h2>
                        <span class="admin-row-summary">@(role.Description ?? "—")</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-secondary btn-sm"
                           data-admin-role-members="@role.Id"
                           asp-page="/SkopkaHelloAdmin/Roles"
                           asp-all-route-data="@(Model.ListContext(role.Id, members: false).Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!))"
                           asp-fragment="@(editPanelId)-members">@Text["Admin.Roles.Members"]</a>
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#@editPanelId">@Text["Admin.Common.Manage"]</button>
                    </div>
                </article>
                <div class="modal fade" id="@editPanelId" data-admin-auto-open="@(Model.ShouldOpen(role.Id) ? "true" : null)" tabindex="-1" aria-labelledby="@(editPanelId)-title" aria-hidden="true">
                    <div class="modal-dialog @(isOpen ? "modal-xl" : null) modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="@(editPanelId)-title">@role.Name</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Text["Admin.Common.Close"]"></button>
                            </div>
                            <div class="modal-body">
                                @if (Model.ShouldOpen(role.Id))
                                {
                                    <partial name="_AdminStatus" model="@((Model.StatusMessage, Model.OutcomeMessage))" />
                                }
                                <div asp-validation-summary="All" class="alert alert-danger admin-validation" role="alert"></div>
                                <div class="row g-3">
                                    <div class="col-12 @(isOpen ? "col-xl-5" : null)">
                                        <dl class="admin-detail-list mb-3">
                                            <div>
                                                <dt>ID</dt>
                                                <dd>@role.Id</dd>
                                            </div>
                                            <div>
                                                <dt>@Text["Admin.Common.Description"]</dt>
                                                <dd>@(role.Description ?? "—")</dd>
                                            </div>
                                            <div>
                                                <dt>@Text["Admin.Roles.ParentRoleId"]</dt>
                                                <dd>@(role.ParentId?.ToString("D") ?? "—")</dd>
                                            </div>
                                        </dl>
                                        <p class="badge text-bg-light border">@Text["Admin.Common.Version", role.Version]</p>
                                        @if (Model.CanEditRoles)
                                        {
                                            <form method="post"
                                                    asp-page-handler="BeginAction"
                                                    class="row g-2">
                                                <input type="hidden" name="action" value="update" />
                                                <input type="hidden" name="roleId" value="@role.Id" />
                                                <input type="hidden"
                                                    name="expectedVersion"
                                                    value="@role.Version" />
                                                <partial name="_AdminListContext" model="@Model.ListContext(role.Id)" />
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label small mb-1"
                                                        for="role-name-@role.Id.ToString("N")">
                                                    @Text["Admin.Common.Name"]
                                                    </label>
                                                    <input class="form-control form-control-sm"
                                                        id="role-name-@role.Id.ToString("N")"
                                                        name="name"
                                                        value="@(Model.PostedValue(role.Id, "name") ?? role.Name)"
                                                        maxlength="256"
                                                        required />
                                                </div>
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label small mb-1"
                                                        for="role-parent-@role.Id.ToString("N")">
                                                    @Text["Admin.Roles.ParentRoleIdOptional"]
                                                    </label>
                                                    <input class="form-control form-control-sm"
                                                        id="role-parent-@role.Id.ToString("N")"
                                                        name="parentId"
                                                        value="@(Model.PostedValue(role.Id, "parentId") ?? role.ParentId?.ToString())" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label small mb-1"
                                                        for="role-description-@role.Id.ToString("N")">
                                                    @Text["Admin.Common.Description"]
                                                    </label>
                                                    <textarea class="form-control form-control-sm"
                                                        id="role-description-@role.Id.ToString("N")"
                                                        name="description"
                                                        rows="2"
                                                        maxlength="1024">@(Model.PostedValue(role.Id, "description") ?? role.Description)</textarea>
                                                </div>
                                                <div class="col-12">
                                                    <button class="btn btn-primary btn-sm" type="submit">
                                                    @Text["Admin.Common.Update"]
                                                    </button>
                                                </div>
                                            </form>
                                            <div class="admin-role-actions">
                                                <form method="post" asp-page-handler="BeginAction">
                                                    <input type="hidden" name="action" value="delete" />
                                                    <input type="hidden" name="roleId" value="@role.Id" />
                                                    <input type="hidden"
                                                        name="expectedVersion"
                                                        value="@role.Version" />
                                                    <partial name="_AdminListContext" model="@Model.ListContext(role.Id)" />
                                                    <button class="btn btn-outline-danger btn-sm"
                                                        type="submit">
                                                    @Text["Admin.Common.Delete"]
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-12 @(isOpen ? "col-xl-7" : null)">
                                        <section class="admin-panel-section admin-role-members"
                                                 id="@(editPanelId)-members"
                                                 aria-labelledby="@(editPanelId)-members-title">
                                            <h3 class="admin-panel-title" id="@(editPanelId)-members-title">
                                                @Text["Admin.Roles.MembersTitle", role.Name]
                                            </h3>
                                            @if (!isOpen)
                                            {
                                                <a class="btn btn-outline-secondary btn-sm"
                                                   asp-page="/SkopkaHelloAdmin/Roles"
                                                   asp-all-route-data="@(Model.ListContext(role.Id, members: false).Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!))"
                                                   asp-fragment="@(editPanelId)-members">@Text["Admin.Roles.Members"]</a>
                                            }
                                            else
                                            {
                                                <form method="get" class="row g-2 align-items-end mb-3">
                                                    <partial name="_AdminListContext" model="@Model.ListContext(role.Id, members: false)" />
                                                    <div class="col-12 col-sm">
                                                        <label class="form-label small mb-1" for="@(editPanelId)-member-search">@Text["Admin.Roles.MemberSearch"]</label>
                                                        <input class="form-control form-control-sm"
                                                               id="@(editPanelId)-member-search"
                                                               name="MemberSearch"
                                                               value="@Model.MemberSearch"
                                                               autocomplete="off"
                                                               placeholder="@Text["Admin.Users.SearchPlaceholder"]" />
                                                    </div>
                                                    <div class="col-12 col-sm-auto d-grid">
                                                        <button class="btn btn-outline-primary btn-sm" type="submit">@Text["Admin.Roles.Find"]</button>
                                                    </div>
                                                </form>

                                                @if (Model.MembersTotal is { } membersTotal && (membersTotal > 0 || !string.IsNullOrWhiteSpace(Model.MemberSearch)))
                                                {
                                                    <p class="small text-body-secondary mb-2" role="status" data-admin-member-count="@membersTotal">
                                                        @(string.IsNullOrWhiteSpace(Model.MemberSearch)
                                                        ? Text["Admin.Roles.MemberCount", membersTotal]
                                                        : Text["Admin.Common.FoundCount", membersTotal])
                                                    </p>
                                                }

                                                @if (Model.Members.Count == 0)
                                                {
                                                    <p class="small text-body-secondary" data-admin-no-members>
                                                        @(string.IsNullOrWhiteSpace(Model.MemberSearch) && Model.MemberCursorId is null
                                                        ? Text["Admin.Roles.NoMembers"]
                                                        : Text["Admin.Roles.NoMatchingMembers"])
                                                    </p>
                                                }
                                                else
                                                {
                                                    <div class="list-group admin-role-member-list mb-2">
                                                        @foreach (var member in Model.Members)
                                                        {
                                                            <div class="list-group-item d-flex flex-wrap align-items-center gap-2" data-admin-member="@member.User.Id">
                                                                <span class="text-break flex-grow-1">
                                                                    <a asp-page="/SkopkaHelloAdmin/Users"
                                                                       asp-route-Search="@(member.User.UserName ?? member.User.Email ?? member.User.Phone)"
                                                                       asp-route-Manage="@member.User.Id">@RolesModel.UserLabel(member.User)</a>
                                                                    @if (member.User.Email is { } memberEmail && memberEmail != member.User.UserName)
                                                                    {
                                                                        <span class="text-body-secondary small">@memberEmail</span>
                                                                    }
                                                                    @if (member.User.Phone is { } memberPhone && memberPhone != member.User.UserName)
                                                                    {
                                                                        <span class="text-body-secondary small">@memberPhone</span>
                                                                    }
                                                                    @foreach (var badge in member.Badges)
                                                                    {
                                                                        <span class="badge @badge.CssClass admin-user-badge">@Model.BadgeLabel(badge)</span>
                                                                    }
                                                                </span>
                                                                @if (Model.CanRemoveMember(member.User.Id))
                                                                {
                                                                    <form method="post" asp-page-handler="BeginAction">
                                                                        <input type="hidden" name="action" value="remove" />
                                                                        <input type="hidden" name="roleId" value="@role.Id" />
                                                                        <input type="hidden" name="targetUserId" value="@member.User.Id" />
                                                                        <input type="hidden" name="targetLabel" value="@RolesModel.UserLabel(member.User)" />
                                                                        <partial name="_AdminListContext" model="@Model.ListContext(role.Id)" />
                                                                        <button class="btn btn-outline-danger btn-sm" type="submit">@Text["Common.Remove"]</button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (Model.MembersNextCursor is { } nextMember)
                                                {
                                                    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-3">
                                                        <a class="btn btn-outline-primary btn-sm"
                                                           asp-page="/SkopkaHelloAdmin/Roles"
                                                           asp-all-route-data="@(Model.ListContext(role.Id, members: false).Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!))"
                                                           asp-route-MemberSearch="@Model.MemberSearch"
                                                           asp-route-MemberCursorCreatedAt="@nextMember.CreatedAt.ToString("O")"
                                                           asp-route-MemberCursorId="@nextMember.Id"
                                                           asp-fragment="@(editPanelId)-members">
                                                            @Text["Admin.Common.NextPage"]
                                                        </a>
                                                    </div>
                                                }

                                                @if (Model.CanManageOpenRoleMembers)
                                                {
                                                    <h4 class="admin-panel-title h6 mt-3">@Text["Admin.Roles.AddMember"]</h4>
                                                    <form method="get" class="row g-2 align-items-end mb-2">
                                                        <partial name="_AdminListContext" model="@Model.ListContext(role.Id, members: false)" />
                                                        <input type="hidden" name="MemberSearch" value="@Model.MemberSearch" />
                                                        <div class="col-12 col-sm">
                                                            <label class="form-label small mb-1" for="@(editPanelId)-add-search">@Text["Admin.Roles.FindAccount"]</label>
                                                            <input class="form-control form-control-sm"
                                                                   id="@(editPanelId)-add-search"
                                                                   name="AddSearch"
                                                                   value="@Model.AddSearch"
                                                                   autocomplete="off"
                                                                   required
                                                                   placeholder="@Text["Admin.Users.SearchPlaceholder"]" />
                                                        </div>
                                                        <div class="col-12 col-sm-auto d-grid">
                                                            <button class="btn btn-outline-primary btn-sm" type="submit">@Text["Admin.Roles.Find"]</button>
                                                        </div>
                                                    </form>
                                                    @if (Model.Candidates is { } candidates)
                                                    {
                                                        @if (candidates.Count == 0)
                                                        {
                                                            <p class="small text-body-secondary">@Text["Admin.Roles.NoCandidates"]</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="list-group admin-role-candidate-list">
                                                                @foreach (var candidate in candidates)
                                                                {
                                                                    var alreadyMember = Model.InOpenRole(candidate);
                                                                    <div class="list-group-item d-flex flex-wrap align-items-center gap-2" data-admin-candidate="@candidate.User.Id">
                                                                        <span class="text-break flex-grow-1">
                                                                            @RolesModel.UserLabel(candidate.User)
                                                                            @foreach (var badge in candidate.Badges)
                                                                            {
                                                                                <span class="badge @badge.CssClass admin-user-badge">@Model.BadgeLabel(badge)</span>
                                                                            }
                                                                        </span>
                                                                        @if (alreadyMember)
                                                                        {
                                                                            <span class="small text-body-secondary" data-admin-candidate-member>@Text["Admin.Roles.AlreadyMember"]</span>
                                                                        }
                                                                        else
                                                                        {
                                                                        <form method="post" asp-page-handler="BeginAction">
                                                                            <input type="hidden" name="action" value="assign" />
                                                                            <input type="hidden" name="roleId" value="@role.Id" />
                                                                            <input type="hidden" name="targetUserId" value="@candidate.User.Id" />
                                                                            <input type="hidden" name="targetLabel" value="@RolesModel.UserLabel(candidate.User)" />
                                                                            <partial name="_AdminListContext" model="@Model.ListContext(role.Id)" />
                                                                            <button class="btn btn-primary btn-sm" type="submit">@Text["Admin.Roles.Add"]</button>
                                                                        </form>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        @if (Model.CandidatesNextCursor is { } nextCandidate)
                                                        {
                                                            <div class="d-flex justify-content-end mt-2">
                                                                <a class="btn btn-outline-primary btn-sm"
                                                                   asp-page="/SkopkaHelloAdmin/Roles"
                                                                   asp-all-route-data="@(Model.ListContext(role.Id, members: false).Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!))"
                                                                   asp-route-MemberSearch="@Model.MemberSearch"
                                                                   asp-route-AddSearch="@Model.AddSearch"
                                                                   asp-route-AddCursorCreatedAt="@nextCandidate.CreatedAt.ToString("O")"
                                                                   asp-route-AddCursorId="@nextCandidate.Id"
                                                                   asp-fragment="@(editPanelId)-members">@Text["Admin.Common.NextPage"]</a>
                                                            </div>
                                                        }
                                                    }
                                                }
                                                else if (Model.CanAssignRoles)
                                                {
                                                    <p class="small text-body-secondary mb-0">@Text["Admin.Roles.MembershipReadOnly"]</p>
                                                }
                                            }
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

    @if (Model.NextCursor is { } next)
    {
        <nav class="d-flex justify-content-end mt-4"
             aria-label="@Text["Admin.Common.NextPage"]">
            <a class="btn btn-outline-primary btn-sm"
               asp-page="/SkopkaHelloAdmin/Roles"
               asp-route-search="@Model.Search"
               asp-route-cursorCreatedAt="@next.CreatedAt.ToString("O")"
               asp-route-cursorId="@next.Id">
                @Text["Admin.Common.NextPage"]
            </a>
        </nav>
    }
</div>
