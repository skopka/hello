@page
@model RolesModel
@{
    ViewData["Title"] = Text["Admin.Roles.PageTitle"];
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">@Text["Admin.Common.Administration"]</p>
    <h1>@Text["Admin.Roles.Title"]</h1>
    <p class="hello-muted">
        @Text["Admin.Roles.Instructions"]
    </p>
    <p><a asp-page="/SkopkaHelloAdmin/Users">@Text["Admin.Roles.ManageUsers"]</a></p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="hello-card" role="status">
        <p>@Model.StatusMessage</p>
    </section>
}

<div asp-validation-summary="All"
     class="hello-validation"
     role="alert"></div>

<section class="hello-card">
    <form method="get" class="hello-form">
        <label for="admin-role-search">@Text["Admin.Common.Search"]</label>
        <input id="admin-role-search"
               asp-for="Search"
               autocomplete="off"
               placeholder="@Text["Admin.Roles.RoleName"]" />
        <button class="hello-button" type="submit">@Text["Admin.Common.ApplyFilter"]</button>
    </form>
</section>

<section class="hello-card">
    <p class="hello-eyebrow">@Text["Admin.Roles.NewRole"]</p>
    <form method="post" asp-page-handler="BeginAction" class="hello-form">
        <input type="hidden" name="action" value="create" />
        <input type="hidden" asp-for="Search" />
        <label>
            @Text["Admin.Common.Name"]
            <input name="name" maxlength="256" required />
        </label>
        <label>
            @Text["Admin.Common.Description"]
            <textarea name="description" maxlength="1024"></textarea>
        </label>
        <label>
            @Text["Admin.Roles.ParentRoleIdOptional"]
            <input name="parentId" inputmode="text" />
        </label>
        <button class="hello-button" type="submit">@Text["Admin.Roles.Create"]</button>
    </form>
</section>

@if (Model.PendingAction is { } pending)
{
    <section class="hello-card" aria-labelledby="admin-role-verification-title">
        <p class="hello-eyebrow">@Text["Admin.Common.StepUp"]</p>
        <h2 id="admin-role-verification-title">
            @Text[RolesModel.GetActionTextKey(pending.Action)]
        </h2>
        <p>
            @Text["Admin.Common.EnterCode",
                pending.DeliveryChannel == HelloDeliveryChannel.Sms
                    ? Text["Field.PhoneNumber"]
                    : pending.DeliveryChannel == HelloDeliveryChannel.Email
                        ? Text["Field.EmailAddress"]
                        : Text["Admin.Common.Contact"]]
            @if (pending.ExpiresAt is { } expiresAt)
            {
                <span>@Text["Admin.Common.ExpiresAt", expiresAt.ToLocalTime()]</span>
            }
        </p>

        <form method="post"
              asp-page-handler="CompleteAction"
              class="hello-form">
            <input type="hidden"
                   name="action"
                   value="@RolesModel.GetActionSlug(pending.Action)" />
            <input type="hidden" name="roleId" value="@pending.RoleId" />
            <input type="hidden"
                   name="targetUserId"
                   value="@pending.TargetUserId" />
            <input type="hidden"
                   name="challengeId"
                   value="@pending.ChallengeId" />
            <input type="hidden"
                   name="expectedVersion"
                   value="@pending.Parameters.ExpectedVersion" />
            <input type="hidden" name="name" value="@pending.Parameters.Name" />
            <input type="hidden"
                   name="description"
                   value="@pending.Parameters.Description" />
            <input type="hidden"
                   name="parentId"
                   value="@pending.Parameters.ParentId" />
            <input type="hidden" asp-for="Search" />

            <label for="admin-role-verification-code">@Text["Field.VerificationCode"]</label>
            <input id="admin-role-verification-code"
                   name="verificationCode"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   required />
            <button class="hello-button hello-button-danger" type="submit">
                @Text["Admin.Common.ConfirmAction",
                    Text[RolesModel.GetActionTextKey(pending.Action)]]
            </button>
        </form>
    </section>
}

@if (Model.Roles.Count == 0)
{
    <section class="hello-card">
        <p>@Text["Admin.Roles.None"]</p>
    </section>
}
else
{
    <div class="hello-session-list">
        @foreach (var role in Model.Roles)
        {
            <article class="hello-card">
                <div>
                    <p class="hello-eyebrow">@Text["Admin.Common.Version", role.Version]</p>
                    <h2>@role.Name</h2>
                    <dl class="hello-session-meta">
                        <div>
                            <dt>@Text["Admin.Roles.RoleId"]</dt>
                            <dd>@role.Id</dd>
                        </div>
                        <div>
                            <dt>@Text["Admin.Common.Description"]</dt>
                            <dd>@(role.Description ?? "—")</dd>
                        </div>
                        <div>
                            <dt>@Text["Admin.Roles.ParentRoleId"]</dt>
                            <dd>@(role.ParentId?.ToString("D") ?? "—")</dd>
                        </div>
                    </dl>
                </div>

                <form method="post"
                      asp-page-handler="BeginAction"
                      class="hello-form">
                    <input type="hidden" name="action" value="update" />
                    <input type="hidden" name="roleId" value="@role.Id" />
                    <input type="hidden"
                           name="expectedVersion"
                           value="@role.Version" />
                    <input type="hidden" asp-for="Search" />
                    <label>
                        @Text["Admin.Common.Name"]
                        <input name="name"
                               value="@role.Name"
                               maxlength="256"
                               required />
                    </label>
                    <label>
                        @Text["Admin.Common.Description"]
                        <textarea name="description"
                                  maxlength="1024">@role.Description</textarea>
                    </label>
                    <label>
                        @Text["Admin.Roles.ParentRoleIdOptional"]
                        <input name="parentId" value="@role.ParentId" />
                    </label>
                    <button class="hello-button" type="submit">@Text["Admin.Common.Update"]</button>
                </form>

                <form method="post" asp-page-handler="BeginAction">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="roleId" value="@role.Id" />
                    <input type="hidden"
                           name="expectedVersion"
                           value="@role.Version" />
                    <input type="hidden" asp-for="Search" />
                    <button class="hello-button hello-button-danger"
                            type="submit">
                        @Text["Admin.Common.Delete"]
                    </button>
                </form>
            </article>
        }
    </div>
}

@if (Model.NextCursor is { } next)
{
    <p>
        <a asp-page="/SkopkaHelloAdmin/Roles"
           asp-route-search="@Model.Search"
           asp-route-cursorCreatedAt="@next.CreatedAt.ToString("O")"
           asp-route-cursorId="@next.Id">
            @Text["Admin.Common.NextPage"]
        </a>
    </p>
}
