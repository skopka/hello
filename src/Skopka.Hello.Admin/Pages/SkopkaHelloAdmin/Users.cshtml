@page
@model UsersModel
@{
    ViewData["Title"] = Text["Admin.Users.PageTitle"];
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">@Text["Admin.Common.Administration"]</p>
    <h1>@Text["Admin.Users.Title"]</h1>
    <p class="hello-muted">
        @Text["Admin.Users.Instructions"]
    </p>
    <p><a asp-page="/SkopkaHelloAdmin/Roles">@Text["Admin.Users.ManageRoles"]</a></p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="hello-card" role="status">
        <p>@Model.StatusMessage</p>
    </section>
}

<div asp-validation-summary="All"
     class="hello-validation"
     role="alert"></div>

<section class="hello-card">
    <form method="get" class="hello-form">
        <label for="admin-search">@Text["Admin.Common.Search"]</label>
        <input id="admin-search"
               asp-for="Search"
               autocomplete="off"
               placeholder="@Text["Admin.Users.SearchPlaceholder"]" />

        <label for="admin-status">@Text["Admin.Users.Status"]</label>
        <select id="admin-status" asp-for="Status">
            @foreach (var value in Enum.GetValues<IdentityUserStatus>())
            {
                <option value="@value">@Text[$"Admin.Users.Status.{value}"]</option>
            }
        </select>

        <button class="hello-button" type="submit">@Text["Admin.Common.ApplyFilters"]</button>
    </form>
</section>

@if (Model.PendingAction is { } pending)
{
    <section class="hello-card" aria-labelledby="admin-verification-title">
        <p class="hello-eyebrow">@Text["Admin.Common.StepUp"]</p>
        <h2 id="admin-verification-title">
            @Text[UsersModel.GetActionTextKey(pending.Action)]
        </h2>
        <p>
            @Text["Admin.Common.EnterCode",
                pending.DeliveryChannel == HelloDeliveryChannel.Sms
                    ? Text["Field.PhoneNumber"]
                    : pending.DeliveryChannel == HelloDeliveryChannel.Email
                        ? Text["Field.EmailAddress"]
                        : Text["Admin.Common.Contact"]]
            @if (pending.ExpiresAt is { } expiresAt)
            {
                <span>@Text["Admin.Common.ExpiresAt", expiresAt.ToLocalTime()]</span>
            }
        </p>

        <form method="post"
              asp-page-handler="CompleteAction"
              class="hello-form">
            <input type="hidden" name="userId" value="@pending.UserId" />
            <input type="hidden"
                   name="action"
                   value="@UsersModel.GetActionSlug(pending.Action)" />
            <input type="hidden"
                   name="challengeId"
                   value="@pending.ChallengeId" />
            <input type="hidden"
                   name="expectedVersion"
                   value="@pending.Parameters.ExpectedVersion" />
            <input type="hidden"
                   name="blockedUntil"
                   value="@(pending.Parameters.BlockedUntil?.ToString("O"))" />
            <input type="hidden"
                   name="reason"
                   value="@pending.Parameters.Reason" />
            <input type="hidden" asp-for="Search" />
            <input type="hidden" asp-for="Status" />

            <label for="admin-verification-code">@Text["Field.VerificationCode"]</label>
            <input id="admin-verification-code"
                   name="verificationCode"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   required />
            <button class="hello-button hello-button-danger" type="submit">
                @Text["Admin.Common.ConfirmAction",
                    Text[UsersModel.GetActionTextKey(pending.Action)]]
            </button>
        </form>
    </section>
}

@if (Model.PendingRoleAction is { } pendingRole)
{
    <section class="hello-card" aria-labelledby="admin-role-verification-title">
        <p class="hello-eyebrow">@Text["Admin.Common.StepUp"]</p>
        <h2 id="admin-role-verification-title">
            @Text[UsersModel.GetRoleActionTextKey(pendingRole.Action)]
        </h2>
        <p>
            @Text["Admin.Common.EnterCode",
                pendingRole.DeliveryChannel == HelloDeliveryChannel.Sms
                    ? Text["Field.PhoneNumber"]
                    : pendingRole.DeliveryChannel == HelloDeliveryChannel.Email
                        ? Text["Field.EmailAddress"]
                        : Text["Admin.Common.Contact"]]
            @if (pendingRole.ExpiresAt is { } expiresAt)
            {
                <span>@Text["Admin.Common.ExpiresAt", expiresAt.ToLocalTime()]</span>
            }
        </p>

        <form method="post"
              asp-page-handler="CompleteRoleAction"
              class="hello-form">
            <input type="hidden"
                   name="userId"
                   value="@pendingRole.TargetUserId" />
            <input type="hidden"
                   name="roleId"
                   value="@pendingRole.RoleId" />
            <input type="hidden"
                   name="action"
                   value="@HelloAdminSecurity.GetActionSlug(pendingRole.Action)" />
            <input type="hidden"
                   name="challengeId"
                   value="@pendingRole.ChallengeId" />
            <input type="hidden" asp-for="Search" />
            <input type="hidden" asp-for="Status" />

            <label for="admin-role-verification-code">@Text["Field.VerificationCode"]</label>
            <input id="admin-role-verification-code"
                   name="verificationCode"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   required />
            <button class="hello-button hello-button-danger" type="submit">
                @Text["Admin.Common.ConfirmAction",
                    Text[UsersModel.GetRoleActionTextKey(pendingRole.Action)]]
            </button>
        </form>
    </section>
}

@if (Model.Users.Count == 0)
{
    <section class="hello-card">
        <p>@Text["Admin.Users.None"]</p>
    </section>
}
else
{
    <div class="hello-session-list">
        @foreach (var user in Model.Users)
        {
            var isBlocked = user.BlockedAt is not null
                && (user.BlockedUntil is null
                    || user.BlockedUntil > DateTimeOffset.UtcNow);
            <article class="hello-card">
                <div>
                    <p class="hello-eyebrow">
                        @if (user.DeletedAt is not null)
                        {
                            <span>@Text["Admin.Users.Deleted"]</span>
                        }
                        else if (isBlocked)
                        {
                            <span>@Text["Admin.Users.Blocked"]</span>
                        }
                        else
                        {
                            <span>@Text["Admin.Users.Active"]</span>
                        }
                        · @Text["Admin.Common.Version", user.Version]
                    </p>
                    <h2>
                        @(user.UserName
                          ?? user.Email
                          ?? user.Phone
                          ?? user.Id.ToString("D"))
                    </h2>
                    <dl class="hello-session-meta">
                        <div>
                            <dt>@Text["Admin.Users.UserId"]</dt>
                            <dd>@user.Id</dd>
                        </div>
                        <div>
                            <dt>@Text["Admin.Users.Flags"]</dt>
                            <dd>@user.Flags</dd>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(user.Email))
                        {
                            <div>
                                <dt>@Text["Field.Email"]</dt>
                                <dd>
                                    @user.Email
                                    @(user.EmailConfirmed
                                        ? Text["Admin.Users.ConfirmedParenthetical"]
                                        : Text["Admin.Users.UnconfirmedParenthetical"])
                                </dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(user.Phone))
                        {
                            <div>
                                <dt>@Text["Field.Phone"]</dt>
                                <dd>
                                    @user.Phone
                                    @(user.PhoneConfirmed
                                        ? Text["Admin.Users.ConfirmedParenthetical"]
                                        : Text["Admin.Users.UnconfirmedParenthetical"])
                                </dd>
                            </div>
                        }
                        @foreach (var field in user.Profile)
                        {
                            <div>
                                <dt>@field.Label</dt>
                                <dd>@(field.Value ?? "—")</dd>
                            </div>
                        }
                        <div>
                            <dt>@Text["Admin.Users.Created"]</dt>
                            <dd>@user.CreatedAt.ToLocalTime()</dd>
                        </div>
                    </dl>

                    <section>
                        <h3>@Text["Admin.Roles.Title"]</h3>
                        @if (Model.UserRoles.TryGetValue(
                                user.Id,
                                out var assignedRoles)
                            && assignedRoles.Count > 0)
                        {
                            <ul>
                                @foreach (var role in assignedRoles)
                                {
                                    <li>
                                        <span>@role.Name (@role.Id)</span>
                                        <form method="post"
                                              asp-page-handler="BeginRoleAction">
                                            <input type="hidden"
                                                   name="userId"
                                                   value="@user.Id" />
                                            <input type="hidden"
                                                   name="roleId"
                                                   value="@role.Id" />
                                            <input type="hidden"
                                                   name="action"
                                                   value="remove" />
                                            <input type="hidden" asp-for="Search" />
                                            <input type="hidden" asp-for="Status" />
                                            <button class="hello-button hello-button-danger"
                                                    type="submit">
                                                @Text["Common.Remove"]
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="hello-muted">@Text["Admin.Users.NoRoles"]</p>
                        }

                        <form method="post"
                              asp-page-handler="BeginRoleAction"
                              class="hello-form">
                            <input type="hidden"
                                   name="userId"
                                   value="@user.Id" />
                            <input type="hidden" name="action" value="assign" />
                            <input type="hidden" asp-for="Search" />
                            <input type="hidden" asp-for="Status" />
                            <label>
                                @Text["Admin.Roles.RoleId"]
                                <input name="roleId" required />
                            </label>
                            <button class="hello-button" type="submit">
                                @Text["Admin.Roles.Assign"]
                            </button>
                        </form>
                    </section>
                </div>

                <div class="hello-danger-zone">
                    @if (user.DeletedAt is not null)
                    {
                        <form method="post" asp-page-handler="BeginAction">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <input type="hidden" name="action" value="restore" />
                            <input type="hidden"
                                   name="expectedVersion"
                                   value="@user.Version" />
                            <input type="hidden" asp-for="Search" />
                            <input type="hidden" asp-for="Status" />
                            <button class="hello-button" type="submit">
                                @Text["Admin.Users.Restore"]
                            </button>
                        </form>
                    }
                    else
                    {
                        @if (isBlocked)
                        {
                            <form method="post" asp-page-handler="BeginAction">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <input type="hidden" name="action" value="unblock" />
                                <input type="hidden"
                                       name="expectedVersion"
                                       value="@user.Version" />
                                <input type="hidden" asp-for="Search" />
                                <input type="hidden" asp-for="Status" />
                                <button class="hello-button" type="submit">
                                    @Text["Admin.Users.Unblock"]
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post"
                                  asp-page-handler="BeginAction"
                                  class="hello-form">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <input type="hidden" name="action" value="block" />
                                <input type="hidden"
                                       name="expectedVersion"
                                       value="@user.Version" />
                                <input type="hidden" asp-for="Search" />
                                <input type="hidden" asp-for="Status" />
                                <label>
                                    @Text["Admin.Users.BlockUntilOptional"]
                                    <input type="datetime-local" name="blockedUntil" />
                                </label>
                                <label>
                                    @Text["Admin.Users.ReasonOptional"]
                                    <input name="reason" maxlength="512" />
                                </label>
                                <button class="hello-button hello-button-danger"
                                        type="submit">
                                    @Text["Admin.Users.Block"]
                                </button>
                            </form>
                        }

                        <form method="post" asp-page-handler="BeginAction">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <input type="hidden"
                                   name="action"
                                   value="revoke-sessions" />
                            <input type="hidden" asp-for="Search" />
                            <input type="hidden" asp-for="Status" />
                            <button class="hello-button hello-button-danger"
                                    type="submit">
                                @Text["Admin.Users.RevokeSessions"]
                            </button>
                        </form>

                        <form method="post"
                              asp-page-handler="BeginAction"
                              class="hello-form">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden"
                                   name="expectedVersion"
                                   value="@user.Version" />
                            <input type="hidden" asp-for="Search" />
                            <input type="hidden" asp-for="Status" />
                            <label>
                                @Text["Admin.Users.DeletionReasonOptional"]
                                <input name="reason" maxlength="512" />
                            </label>
                            <button class="hello-button hello-button-danger"
                                    type="submit">
                                @Text["Admin.Common.Delete"]
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}

@if (Model.NextCursor is { } nextCursor)
{
    <p>
        <a class="hello-button"
           asp-page="/SkopkaHelloAdmin/Users"
           asp-route-Search="@Model.Search"
           asp-route-Status="@Model.Status"
           asp-route-CursorCreatedAt="@nextCursor.CreatedAt.ToString("O")"
           asp-route-CursorId="@nextCursor.Id">
            @Text["Admin.Common.NextPage"]
        </a>
    </p>
}
