@page
@model UsersModel
@{
    ViewData["Title"] = Text["Admin.Users.PageTitle"];
    ViewData["AdminSection"] = "users";
}

<header class="admin-page-header">
    <div>
        <div class="admin-eyebrow">@Text["Admin.Common.Administration"]</div>
        <h1>@Text["Admin.Users.Title"]</h1>
        <p>@Text["Admin.Users.Instructions"]</p>
    </div>
    <a class="btn btn-outline-primary btn-sm"
       asp-page="/SkopkaHelloAdmin/Roles">
        @Text["Admin.Users.ManageRoles"]
    </a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success shadow-sm" role="status">
        @Model.StatusMessage
    </div>
}

<div asp-validation-summary="All"
     class="alert alert-danger admin-validation"
     role="alert"></div>

<section class="card admin-card admin-filter-card mb-4"
         aria-label="@Text["Admin.Common.ApplyFilters"]">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-lg-7">
                <label class="form-label small mb-1"
                       for="admin-search">
                    @Text["Admin.Common.Search"]
                </label>
                <input class="form-control form-control-sm"
                       id="admin-search"
                       asp-for="Search"
                       autocomplete="off"
                       placeholder="@Text["Admin.Users.SearchPlaceholder"]" />
            </div>
            <div class="col-12 col-sm-7 col-lg-3">
                <label class="form-label small mb-1"
                       for="admin-status">
                    @Text["Admin.Users.Status"]
                </label>
                <select class="form-select form-select-sm"
                        id="admin-status"
                        asp-for="Status">
                    @foreach (var value in Enum.GetValues<IdentityUserStatus>())
                    {
                        <option value="@value">
                            @Text[$"Admin.Users.Status.{value}"]
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-5 col-lg-2 d-grid">
                <button class="btn btn-primary btn-sm" type="submit">
                    @Text["Admin.Common.ApplyFilters"]
                </button>
            </div>
        </form>
    </div>
</section>

@if (Model.PendingAction is { } pending)
{
    <section class="alert alert-warning shadow-sm"
             aria-labelledby="admin-verification-title">
        <div class="admin-eyebrow">@Text["Admin.Common.StepUp"]</div>
        <h2 class="h5" id="admin-verification-title">
            @Text[UsersModel.GetActionTextKey(pending.Action)]
        </h2>
        <p class="small mb-3">
            @(pending.DeliveryChannel == HelloDeliveryChannel.Authenticator
                ? Text["Admin.Common.EnterAuthenticatorCode"]
                : Text["Admin.Common.EnterCode",
                    pending.DeliveryChannel == HelloDeliveryChannel.Sms
                        ? Text["Field.PhoneNumber"]
                        : Text["Field.EmailAddress"]])
            @if (pending.ExpiresAt is { } expiresAt)
            {
                <span>@Text["Admin.Common.ExpiresAt", expiresAt.ToLocalTime()]</span>
            }
        </p>

        <form method="post"
              asp-page-handler="CompleteAction"
              class="row g-2 align-items-end">
            <input type="hidden" name="userId" value="@pending.UserId" />
            <input type="hidden"
                   name="action"
                   value="@UsersModel.GetActionSlug(pending.Action)" />
            <input type="hidden"
                   name="challengeId"
                   value="@pending.ChallengeId" />
            <input type="hidden"
                   name="expectedVersion"
                   value="@pending.Parameters.ExpectedVersion" />
            <input type="hidden"
                   name="blockedUntil"
                   value="@(pending.Parameters.BlockedUntil?.ToString("O"))" />
            <input type="hidden"
                   name="reason"
                   value="@pending.Parameters.Reason" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="Status" value="@Model.Status" />

            <div class="col-12 col-sm-7 col-lg-4">
                <label class="form-label small mb-1"
                       for="admin-verification-code">
                    @Text["Field.VerificationCode"]
                </label>
                <input class="form-control form-control-sm"
                       id="admin-verification-code"
                       name="verificationCode"
                       inputmode="@(pending.DeliveryChannel == HelloDeliveryChannel.Authenticator ? "text" : "numeric")"
                       autocomplete="one-time-code"
                       required />
            </div>
            <div class="col-12 col-sm-auto">
                <button class="btn btn-danger btn-sm" type="submit">
                    @Text["Admin.Common.ConfirmAction",
                        Text[UsersModel.GetActionTextKey(pending.Action)]]
                </button>
            </div>
        </form>
    </section>
}

@if (Model.PendingRoleAction is { } pendingRole)
{
    <section class="alert alert-warning shadow-sm"
             aria-labelledby="admin-role-verification-title">
        <div class="admin-eyebrow">@Text["Admin.Common.StepUp"]</div>
        <h2 class="h5" id="admin-role-verification-title">
            @Text[UsersModel.GetRoleActionTextKey(pendingRole.Action)]
        </h2>
        <p class="small mb-3">
            @(pendingRole.DeliveryChannel == HelloDeliveryChannel.Authenticator
                ? Text["Admin.Common.EnterAuthenticatorCode"]
                : Text["Admin.Common.EnterCode",
                    pendingRole.DeliveryChannel == HelloDeliveryChannel.Sms
                        ? Text["Field.PhoneNumber"]
                        : Text["Field.EmailAddress"]])
            @if (pendingRole.ExpiresAt is { } expiresAt)
            {
                <span>@Text["Admin.Common.ExpiresAt", expiresAt.ToLocalTime()]</span>
            }
        </p>

        <form method="post"
              asp-page-handler="CompleteRoleAction"
              class="row g-2 align-items-end">
            <input type="hidden"
                   name="userId"
                   value="@pendingRole.TargetUserId" />
            <input type="hidden"
                   name="roleId"
                   value="@pendingRole.RoleId" />
            <input type="hidden"
                   name="action"
                   value="@HelloAdminSecurity.GetActionSlug(pendingRole.Action)" />
            <input type="hidden"
                   name="challengeId"
                   value="@pendingRole.ChallengeId" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="Status" value="@Model.Status" />

            <div class="col-12 col-sm-7 col-lg-4">
                <label class="form-label small mb-1"
                       for="admin-role-verification-code">
                    @Text["Field.VerificationCode"]
                </label>
                <input class="form-control form-control-sm"
                       id="admin-role-verification-code"
                       name="verificationCode"
                       inputmode="@(pendingRole.DeliveryChannel == HelloDeliveryChannel.Authenticator ? "text" : "numeric")"
                       autocomplete="one-time-code"
                       required />
            </div>
            <div class="col-12 col-sm-auto">
                <button class="btn btn-danger btn-sm" type="submit">
                    @Text["Admin.Common.ConfirmAction",
                        Text[UsersModel.GetRoleActionTextKey(pendingRole.Action)]]
                </button>
            </div>
        </form>
    </section>
}

@if (Model.Users.Count == 0)
{
    <div class="alert alert-light border shadow-sm">
        @Text["Admin.Users.None"]
    </div>
}
else
{
    <section class="d-grid gap-3"
             aria-label="@Text["Admin.Users.Title"]">
        @foreach (var user in Model.Users)
        {
            var isBlocked = user.BlockedAt is not null
                && (user.BlockedUntil is null
                    || user.BlockedUntil > DateTimeOffset.UtcNow);
            var statusTextKey = user.DeletedAt is not null
                ? "Admin.Users.Deleted"
                : isBlocked
                    ? "Admin.Users.Blocked"
                    : "Admin.Users.Active";
            var statusBadgeClass = user.DeletedAt is not null
                ? "text-bg-secondary"
                : isBlocked
                    ? "text-bg-warning"
                    : "text-bg-success";
            var managePanelId = $"admin-user-{user.Id:N}";

            <article class="card admin-card admin-user-card">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                        <div class="min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="badge @statusBadgeClass">
                                    @Text[statusTextKey]
                                </span>
                                <span class="badge text-bg-light border">
                                    @Text["Admin.Common.Version", user.Version]
                                </span>
                            </div>
                            <h2 class="admin-user-title">
                                @(user.UserName
                                  ?? user.Email
                                  ?? user.Phone
                                  ?? user.Id.ToString("D"))
                            </h2>
                            <div class="admin-subtitle">@user.Id</div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@managePanelId"
                                aria-expanded="false"
                                aria-controls="@managePanelId">
                            @Text["Admin.Common.Manage"]
                        </button>
                    </div>

                    <div class="admin-meta-grid">
                        <div class="admin-meta-item">
                            <div class="admin-meta-label">@Text["Field.Email"]</div>
                            <div class="admin-meta-value">
                                @if (!string.IsNullOrWhiteSpace(user.Email))
                                {
                                    <span>@user.Email</span>
                                    <span class="badge rounded-pill @(user.EmailConfirmed ? "text-bg-success" : "text-bg-light border")">
                                        @(user.EmailConfirmed
                                            ? Text["Admin.Users.ConfirmedParenthetical"]
                                            : Text["Admin.Users.UnconfirmedParenthetical"])
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                        <div class="admin-meta-item">
                            <div class="admin-meta-label">@Text["Field.Phone"]</div>
                            <div class="admin-meta-value">
                                @if (!string.IsNullOrWhiteSpace(user.Phone))
                                {
                                    <span>@user.Phone</span>
                                    <span class="badge rounded-pill @(user.PhoneConfirmed ? "text-bg-success" : "text-bg-light border")">
                                        @(user.PhoneConfirmed
                                            ? Text["Admin.Users.ConfirmedParenthetical"]
                                            : Text["Admin.Users.UnconfirmedParenthetical"])
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                        <div class="admin-meta-item">
                            <div class="admin-meta-label">@Text["Admin.Users.Created"]</div>
                            <div class="admin-meta-value">
                                @user.CreatedAt.ToLocalTime().ToString("g")
                            </div>
                        </div>
                        <div class="admin-meta-item">
                            <div class="admin-meta-label">@Text["Admin.Users.Flags"]</div>
                            <div class="admin-meta-value">@user.Flags</div>
                        </div>
                    </div>

                    <div class="collapse admin-manage-panel" id="@managePanelId">
                        <div class="row g-3">
                            <div class="col-12 col-xl-4">
                                <section class="admin-panel-section">
                                    <h3 class="admin-panel-title">
                                        @Text["Admin.Users.ProfileDetails"]
                                    </h3>
                                    <dl class="admin-detail-list">
                                        <div>
                                            <dt>@Text["Admin.Users.UserId"]</dt>
                                            <dd>@user.Id</dd>
                                        </div>
                                        @foreach (var field in user.Profile)
                                        {
                                            <div>
                                                <dt>@field.Label</dt>
                                                <dd>@(field.Value ?? "—")</dd>
                                            </div>
                                        }
                                    </dl>
                                </section>
                            </div>

                            <div class="col-12 col-xl-4">
                                <section class="admin-panel-section">
                                    <h3 class="admin-panel-title">
                                        @Text["Admin.Users.RoleMembership"]
                                    </h3>
                                    @if (Model.UserRoles.TryGetValue(
                                            user.Id,
                                            out var assignedRoles)
                                        && assignedRoles.Count > 0)
                                    {
                                        <div class="list-group admin-role-membership-list">
                                            @foreach (var role in assignedRoles)
                                            {
                                                <div class="list-group-item">
                                                    <span class="text-break">
                                                        @role.Name
                                                        <span class="text-body-secondary">
                                                            (@role.Id)
                                                        </span>
                                                    </span>
                                                    <form method="post"
                                                          asp-page-handler="BeginRoleAction">
                                                        <input type="hidden"
                                                               name="userId"
                                                               value="@user.Id" />
                                                        <input type="hidden"
                                                               name="roleId"
                                                               value="@role.Id" />
                                                        <input type="hidden"
                                                               name="action"
                                                               value="remove" />
                                                        <input type="hidden"
                                                               name="Search"
                                                               value="@Model.Search" />
                                                        <input type="hidden"
                                                               name="Status"
                                                               value="@Model.Status" />
                                                        <button class="btn btn-outline-danger btn-sm"
                                                                type="submit">
                                                            @Text["Common.Remove"]
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="small text-body-secondary">
                                            @Text["Admin.Users.NoRoles"]
                                        </p>
                                    }

                                    <form method="post"
                                          asp-page-handler="BeginRoleAction"
                                          class="row g-2 align-items-end">
                                        <input type="hidden"
                                               name="userId"
                                               value="@user.Id" />
                                        <input type="hidden"
                                               name="action"
                                               value="assign" />
                                        <input type="hidden"
                                               name="Search"
                                               value="@Model.Search" />
                                        <input type="hidden"
                                               name="Status"
                                               value="@Model.Status" />
                                        <div class="col-12 col-md">
                                            <label class="form-label small mb-1"
                                                   for="role-id-@user.Id.ToString("N")">
                                                @Text["Admin.Roles.RoleId"]
                                            </label>
                                            <input class="form-control form-control-sm"
                                                   id="role-id-@user.Id.ToString("N")"
                                                   name="roleId"
                                                   required />
                                        </div>
                                        <div class="col-12 col-md-auto d-grid">
                                            <button class="btn btn-primary btn-sm"
                                                    type="submit">
                                                @Text["Admin.Roles.Assign"]
                                            </button>
                                        </div>
                                    </form>
                                </section>
                            </div>

                            <div class="col-12 col-xl-4">
                                <section class="admin-panel-section admin-danger-panel">
                                    <h3 class="admin-panel-title">
                                        @Text["Admin.Users.AccountActions"]
                                    </h3>
                                    <div class="admin-action-stack">
                                        @if (user.DeletedAt is not null)
                                        {
                                            <form method="post"
                                                  asp-page-handler="BeginAction">
                                                <input type="hidden"
                                                       name="userId"
                                                       value="@user.Id" />
                                                <input type="hidden"
                                                       name="action"
                                                       value="restore" />
                                                <input type="hidden"
                                                       name="expectedVersion"
                                                       value="@user.Version" />
                                                <input type="hidden"
                                                       name="Search"
                                                       value="@Model.Search" />
                                                <input type="hidden"
                                                       name="Status"
                                                       value="@Model.Status" />
                                                <button class="btn btn-outline-success btn-sm"
                                                        type="submit">
                                                    @Text["Admin.Users.Restore"]
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="admin-action-block">
                                                @if (isBlocked)
                                                {
                                                    <form method="post"
                                                          asp-page-handler="BeginAction">
                                                        <input type="hidden"
                                                               name="userId"
                                                               value="@user.Id" />
                                                        <input type="hidden"
                                                               name="action"
                                                               value="unblock" />
                                                        <input type="hidden"
                                                               name="expectedVersion"
                                                               value="@user.Version" />
                                                        <input type="hidden"
                                                               name="Search"
                                                               value="@Model.Search" />
                                                        <input type="hidden"
                                                               name="Status"
                                                               value="@Model.Status" />
                                                        <button class="btn btn-outline-success btn-sm"
                                                                type="submit">
                                                            @Text["Admin.Users.Unblock"]
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post"
                                                          asp-page-handler="BeginAction"
                                                          class="row g-2">
                                                        <input type="hidden"
                                                               name="userId"
                                                               value="@user.Id" />
                                                        <input type="hidden"
                                                               name="action"
                                                               value="block" />
                                                        <input type="hidden"
                                                               name="expectedVersion"
                                                               value="@user.Version" />
                                                        <input type="hidden"
                                                               name="Search"
                                                               value="@Model.Search" />
                                                        <input type="hidden"
                                                               name="Status"
                                                               value="@Model.Status" />
                                                        <div class="col-12">
                                                            <label class="form-label small mb-1"
                                                                   for="block-until-@user.Id.ToString("N")">
                                                                @Text["Admin.Users.BlockUntilOptional"]
                                                            </label>
                                                            <input class="form-control form-control-sm"
                                                                   id="block-until-@user.Id.ToString("N")"
                                                                   type="datetime-local"
                                                                   name="blockedUntil" />
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label small mb-1"
                                                                   for="block-reason-@user.Id.ToString("N")">
                                                                @Text["Admin.Users.ReasonOptional"]
                                                            </label>
                                                            <input class="form-control form-control-sm"
                                                                   id="block-reason-@user.Id.ToString("N")"
                                                                   name="reason"
                                                                   maxlength="512" />
                                                        </div>
                                                        <div class="col-12">
                                                            <button class="btn btn-outline-danger btn-sm"
                                                                    type="submit">
                                                                @Text["Admin.Users.Block"]
                                                            </button>
                                                        </div>
                                                    </form>
                                                }
                                            </div>

                                            <div class="admin-action-block d-flex flex-wrap gap-2">
                                                <form method="post"
                                                      asp-page-handler="BeginAction">
                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.Id" />
                                                    <input type="hidden"
                                                           name="action"
                                                           value="revoke-sessions" />
                                                    <input type="hidden"
                                                           name="Search"
                                                           value="@Model.Search" />
                                                    <input type="hidden"
                                                           name="Status"
                                                           value="@Model.Status" />
                                                    <button class="btn btn-outline-secondary btn-sm"
                                                            type="submit">
                                                        @Text["Admin.Users.RevokeSessions"]
                                                    </button>
                                                </form>
                                                <form method="post"
                                                      asp-page-handler="BeginAction">
                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.Id" />
                                                    <input type="hidden"
                                                           name="action"
                                                           value="reset-authenticator" />
                                                    <input type="hidden"
                                                           name="Search"
                                                           value="@Model.Search" />
                                                    <input type="hidden"
                                                           name="Status"
                                                           value="@Model.Status" />
                                                    <button class="btn btn-outline-danger btn-sm"
                                                            type="submit">
                                                        @Text["Admin.Users.ResetAuthenticator"]
                                                    </button>
                                                </form>
                                            </div>

                                            <div class="admin-action-block">
                                                <form method="post"
                                                      asp-page-handler="BeginAction"
                                                      class="row g-2">
                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.Id" />
                                                    <input type="hidden"
                                                           name="action"
                                                           value="delete" />
                                                    <input type="hidden"
                                                           name="expectedVersion"
                                                           value="@user.Version" />
                                                    <input type="hidden"
                                                           name="Search"
                                                           value="@Model.Search" />
                                                    <input type="hidden"
                                                           name="Status"
                                                           value="@Model.Status" />
                                                    <div class="col-12">
                                                        <label class="form-label small mb-1"
                                                               for="delete-reason-@user.Id.ToString("N")">
                                                            @Text["Admin.Users.DeletionReasonOptional"]
                                                        </label>
                                                        <input class="form-control form-control-sm"
                                                               id="delete-reason-@user.Id.ToString("N")"
                                                               name="reason"
                                                               maxlength="512" />
                                                    </div>
                                                    <div class="col-12">
                                                        <button class="btn btn-danger btn-sm"
                                                                type="submit">
                                                            @Text["Admin.Common.Delete"]
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </section>
}

@if (Model.NextCursor is { } nextCursor)
{
    <nav class="d-flex justify-content-end mt-4"
         aria-label="@Text["Admin.Common.NextPage"]">
        <a class="btn btn-outline-primary btn-sm"
           asp-page="/SkopkaHelloAdmin/Users"
           asp-route-Search="@Model.Search"
           asp-route-Status="@Model.Status"
           asp-route-CursorCreatedAt="@nextCursor.CreatedAt.ToString("O")"
           asp-route-CursorId="@nextCursor.Id">
            @Text["Admin.Common.NextPage"]
        </a>
    </nav>
}
