{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SkopkaHello__Cookies__Secure": "false",
        "SkopkaHello__PublicOrigin": "http://localhost:8080"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:8443;http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SkopkaHello__Jwt__Issuer": "https://localhost:8443",
        "SkopkaHello__PublicOrigin": "https://localhost:8443"
      }
    }
  }
}
