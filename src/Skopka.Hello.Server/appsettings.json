{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SkopkaHello": {
    "PublicOrigin": "https://localhost:8443",
    "Jwt": {
      "CurrentVersion": "v1",
      "Audience": "skopka-hello-api",
      "ValidateSessionOnEveryRequest": false
    },
    "Cookies": {
      "Secure": true
    },
    "SelfRegistration": {
      "Enabled": true,
      "ClientPermitLimit": 5,
      "ClientWindow": "01:00:00",
      "GlobalPermitLimit": 100,
      "GlobalWindow": "00:01:00"
    },
    "Ui": {
      "PathPrefix": "/hello"
    },
    "Admin": {
      "ApiPathPrefix": "/admin",
      "RazorUiEnabled": true,
      "ReadPolicyName": "Skopka.Hello.Admin.Read",
      "ManagePolicyName": "Skopka.Hello.Admin.Manage",
      "DeletePolicyName": "Skopka.Hello.Admin.Delete",
      "ReadRoleName": "Skopka.Hello.Admin",
      "ManageRoleName": "Skopka.Hello.Admin",
      "DeleteRoleName": "Skopka.Hello.Admin"
    },
    "Persistence": {
      "DurableDeliveryEnabled": true,
      "AuditEnabled": true,
      "PollingInterval": "00:00:01",
      "CommandTimeout": "00:00:05",
      "LeaseDuration": "00:01:00",
      "RetryDelay": "00:00:10",
      "MaximumAttempts": 8,
      "AnonymousRequestLifetime": "01:00:00",
      "FailedRecordRetention": "7.00:00:00",
      "AuditRetention": "90.00:00:00",
      "PruningInterval": "01:00:00",
      "PruningBatchSize": 500
    },
    "RateLimiting": {
      "CurrentVersion": "v1"
    },
    "RateLimitPruning": {
      "Interval": "01:00:00",
      "MaximumBatchesPerRun": 20,
      "TimeBudget": "00:00:30"
    },
    "Verification": {
      "CurrentVersion": "v1"
    },
    "Https": {
      "UseRedirection": false
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    },
    "ExternalOidc": {
      "PasswordSignInEnabled": true,
      "Providers": {
        "google": {
          "Enabled": false,
          "DisplayName": "Google",
          "Authority": "https://accounts.google.com",
          "ClientId": "",
          "ClientSecret": "",
          "RequireHttpsMetadata": true,
          "Order": 10,
          "Scopes": []
        }
      }
    },
    "AuthorizationServer": {
      "Enabled": false,
      "Issuer": null,
      "Resource": "skopka-hello-api",
      "AccessTokenFormat": "Reference",
      "AccessTokenLifetime": "00:15:00",
      "AdditionalScopes": [],
      "AuthorizationEndpointPath": "/connect/authorize",
      "TokenEndpointPath": "/connect/token",
      "Clients": []
    },
    "Customization": {
      "CssRequestPath": "/_content/Skopka.Hello.UI/custom.css",
      "BuiltInStylesEnabled": true
    },
    "Delivery": {
      "AnonymousRequestQueueCapacity": 256,
      "VerificationChannel": "Email",
      "EmailProviderId": "",
      "SmsProviderId": "",
      "Smtp": {
        "ProviderId": "smtp",
        "Port": 587,
        "EnableSsl": true,
        "FromName": "Skopka.Hello",
        "QueueCapacity": 256
      }
    }
  }
}
