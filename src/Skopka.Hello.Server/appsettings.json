{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SkopkaHello": {
    "Jwt": {
      "Issuer": "https://localhost:8080",
      "Audience": "skopka-hello-api",
      "ValidateSessionOnEveryRequest": false
    },
    "Cookies": {
      "Secure": true
    },
    "Database": {
      "ApplyMigrations": false
    },
    "Https": {
      "UseRedirection": false
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    }
  }
}
