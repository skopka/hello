@page "/hello/account/change-password"
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">Account security</p>
    <h1>Change password</h1>
    <p class="hello-muted">
        A one-time verification code will be sent to your confirmed
        email address.
    </p>

    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (!Model.CodeRequested)
    {
        <form method="post"
              asp-page-handler="RequestCode"
              class="hello-form">
            <button class="hello-button" type="submit">
                Send verification code
            </button>
        </form>
    }
    else
    {
        <p class="hello-status" role="status">
            The verification code has been sent.
            @if (Model.CodeExpiresAt is not null)
            {
                <span>
                    It expires at
                    @Model.CodeExpiresAt.Value.ToUniversalTime().ToString("u")
                    UTC.
                </span>
            }
        </p>

        <form method="post"
              asp-page-handler="Change"
              class="hello-form">
            <input asp-for="Input.ChallengeId" type="hidden" />

            <label asp-for="Input.VerificationCode"></label>
            <input asp-for="Input.VerificationCode"
                   autocomplete="one-time-code"
                   inputmode="numeric" />
            <span asp-validation-for="Input.VerificationCode"
                  class="hello-field-error"></span>

            <label asp-for="Input.CurrentPassword"></label>
            <input asp-for="Input.CurrentPassword"
                   autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword"
                  class="hello-field-error"></span>

            <label asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"
                  class="hello-field-error"></span>

            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                Change password and sign out
            </button>
        </form>

        <form method="post"
              asp-page-handler="RequestCode"
              class="hello-form">
            <button class="hello-button hello-button-secondary"
                    type="submit">
                Send a new code
            </button>
        </form>
    }

    <p class="hello-card-footer">
        <a href="@HelloUiDefaults.AccountPath">Back to account</a>
    </p>
</section>
