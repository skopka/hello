@page "/hello/account"
@model AccountModel
@{
    ViewData["Title"] = "Account";
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">Account</p>
    <h1>Hello, @Model.DisplayName</h1>
    <p class="hello-muted">
        This page is authenticated by a protected browser session backed by
        Skopka.Identity.
    </p>
</section>

<section class="hello-card">
    <h2>Profile</h2>
    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (Model.ConfirmationRequested)
    {
        <p class="hello-status" role="status">
            If the address still needs confirmation, a new link has
            been sent.
        </p>
    }

    <dl class="hello-details">
        <div>
            <dt>User ID</dt>
            <dd><code>@Model.UserId</code></dd>
        </div>
        <div>
            <dt>User name</dt>
            <dd>@(Model.UserName ?? "Not set")</dd>
        </div>
        <div>
            <dt>Email</dt>
            <dd>@(Model.Email ?? "Not set")</dd>
        </div>
        <div>
            <dt>Email status</dt>
            <dd>@(Model.EmailConfirmed ? "Confirmed" : "Not confirmed")</dd>
        </div>
    </dl>

    <div class="hello-actions">
        <a class="hello-button"
           href="@HelloUiDefaults.SessionsPath">
            Manage sessions
        </a>
        <form method="post" asp-page-handler="Logout">
            <button class="hello-button hello-button-secondary"
                    type="submit">
                Sign out
            </button>
        </form>
        @if (!Model.EmailConfirmed && Model.Email is not null)
        {
            <form method="post"
                  asp-page-handler="RequestEmailConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    Send confirmation link
                </button>
            </form>
        }
    </div>
</section>
