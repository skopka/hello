@page "/hello/confirm-email"
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">Email confirmation</p>
    <h1>Confirm your email</h1>

    @if (Model.Confirmed)
    {
        <p class="hello-status" role="status">
            Your email address is confirmed.
        </p>
        <p class="hello-card-footer">
            <a href="@HelloUiDefaults.AccountPath">Continue to account</a>
        </p>
    }
    else if (!Model.LinkValid)
    {
        <p class="hello-validation" role="alert">
            This email confirmation link is incomplete or invalid.
        </p>
    }
    else
    {
        <p class="hello-muted">
            For safety, opening the link does not change your account.
            Use the button below to confirm the address.
        </p>

        <form method="post" class="hello-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <button class="hello-button" type="submit">
                Confirm email
            </button>
        </form>
    }
</section>
