@page "/hello/external/complete"
@model ExternalCompleteModel
@{
    ViewData["Title"] = "Complete external sign-in";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">External identity</p>
    <h1>Complete sign-in</h1>
    <p class="hello-muted">
        Continue on this site to finish the validated provider response.
    </p>

    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    <form method="post" class="hello-form">
        <button class="hello-button" type="submit" autofocus>
            Continue securely
        </button>
    </form>

    <form method="post"
          asp-page-handler="Cancel"
          class="hello-card-footer">
        <button class="hello-link-button" type="submit">
            Cancel and return to sign in
        </button>
    </form>
</section>
