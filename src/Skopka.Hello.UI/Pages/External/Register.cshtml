@page "/hello/external/register"
@model ExternalRegisterModel
@{
    ViewData["Title"] = "Create external account";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">New account</p>
    <h1>Complete your account</h1>
    @if (Model.Provider is not null)
    {
        <p class="hello-muted">
            Continue with the identity validated by
            <strong>@Model.Provider.DisplayName</strong>.
            A provider-verified email is only used as a form hint;
            Skopka.Hello keeps its own email-confirmation status.
        </p>
    }

    <form method="post" class="hello-form">
        <div asp-validation-summary="ModelOnly"
             class="hello-validation"
             role="alert"></div>

        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" autocomplete="name" />
        <span asp-validation-for="Input.DisplayName"
              class="hello-field-error"></span>

        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email"
              class="hello-field-error"></span>

        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" autocomplete="username" />
        <span asp-validation-for="Input.UserName"
              class="hello-field-error"></span>

        <label asp-for="Input.Phone"></label>
        <input asp-for="Input.Phone" autocomplete="tel" />
        <span asp-validation-for="Input.Phone"
              class="hello-field-error"></span>

        <label asp-for="Input.Locale"></label>
        <input asp-for="Input.Locale" autocomplete="language" />
        <span asp-validation-for="Input.Locale"
              class="hello-field-error"></span>

        <button class="hello-button" type="submit">
            Create account and sign in
        </button>
    </form>

    <form method="post"
          asp-page-handler="Cancel"
          class="hello-card-footer">
        <button class="hello-link-button" type="submit">
            Cancel and return to sign in
        </button>
    </form>
</section>
