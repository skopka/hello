@page "/hello/login"
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">Welcome back</p>
    <h1>Sign in</h1>

    @if (Model.Registered)
    {
        <p class="hello-status" role="status">
            Your account was created. You can sign in now.
        </p>
    }

    @if (Model.PasswordReset)
    {
        <p class="hello-status" role="status">
            Your password was changed. Sign in with the new password.
        </p>
    }

    <form method="post" class="hello-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly"
             class="hello-validation"
             role="alert"></div>

        <label asp-for="Input.Handle"></label>
        <select asp-for="Input.Handle">
            <option value="email">Email</option>
            <option value="userName">User name</option>
        </select>
        <span asp-validation-for="Input.Handle"
              class="hello-field-error"></span>

        <label asp-for="Input.Login"></label>
        <input asp-for="Input.Login" autocomplete="username" />
        <span asp-validation-for="Input.Login"
              class="hello-field-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password"
               autocomplete="current-password" />
        <span asp-validation-for="Input.Password"
              class="hello-field-error"></span>

        <a class="hello-form-help"
           href="@HelloUiDefaults.ForgotPasswordPath">
            Forgot your password?
        </a>

        <button class="hello-button" type="submit">
            Sign in
        </button>
    </form>

    <p class="hello-card-footer">
        Need an account?
        <a href="@HelloUiDefaults.RegisterPath">Register</a>
        <br />
        <a href="@HelloUiDefaults.ResendConfirmationPath">
            Resend email confirmation
        </a>
    </p>
</section>
