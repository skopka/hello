@inject IHelloUiExternalApplication ExternalIdentity
@inject IHelloUiApplication HelloApplication
@{
    var showLanguageSelector = UiOptions.Localization.Enabled
        && UiOptions.Localization.SupportedCultures.Count > 1;
    var showLegalLinks = UiOptions.TermsOfServiceUrl is not null
        || UiOptions.PrivacyPolicyUrl is not null;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isLoginPage = String.Equals(
        currentPage,
        "/SkopkaHello/Login",
        StringComparison.OrdinalIgnoreCase);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAccountPage = String.Equals(
        currentPage,
        "/SkopkaHello/Account/Index",
        StringComparison.OrdinalIgnoreCase);
    var isSessionsPage = String.Equals(
        currentPage,
        "/SkopkaHello/Account/Sessions",
        StringComparison.OrdinalIgnoreCase);
    var isSignInRequestsPage = String.Equals(
        currentPage,
        "/SkopkaHello/CrossDevice/Requests",
        StringComparison.OrdinalIgnoreCase);
    var isSignInMethodsPage = String.Equals(
        currentPage,
        "/SkopkaHello/Account/ExternalLogins",
        StringComparison.OrdinalIgnoreCase);
    var crossDeviceApprovalAvailable = isAuthenticated
        && await HelloUiCrossDeviceApprovalAvailability.IsAvailableAsync(
            Context,
            HelloApplication,
            Context.RequestAborted);
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Skopka.Hello</title>
    @if (UiOptions.BuiltInStylesEnabled)
    {
        <link rel="stylesheet"
              href="@HelloUiDefaults.BuiltInStylesheetPath" />
    }
    @if (UiOptions.CustomCssFilePath is not null)
    {
        <link rel="stylesheet"
              href="@UiOptions.CustomCssRequestPath" />
    }
</head>
<body class="@(isAuthenticated ? "hello-authenticated" : null)">
    <header class="hello-header">
        @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
        {
            <a class="hello-brand" asp-page="/SkopkaHello/Index">
                Skopka.Hello
            </a>
        }
        else if ((UiOptions.EnabledPages & HelloUiPages.Login) != 0)
        {
            <a class="hello-brand" asp-page="/SkopkaHello/Login">
                Skopka.Hello
            </a>
        }
        else
        {
            <span class="hello-brand">Skopka.Hello</span>
        }
        <nav class="@(isAuthenticated
                        ? "hello-account-nav"
                        : "hello-public-nav")"
             aria-label="@Text["Layout.AccountNavigation"]">
            @if (UiOptions.ApplicationHomeUrl is not null)
            {
                <a class="hello-nav-item"
                   href="@UiOptions.ApplicationHomeUrl">
                    <svg class="hello-nav-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M3 11.5 12 4l9 7.5" />
                        <path d="M5.5 10v10h13V10" />
                        <path d="M9.5 20v-6h5v6" />
                    </svg>
                    <span class="hello-nav-label hello-nav-label-desktop">
                        @Text["Layout.ReturnToApplication"]
                    </span>
                    <span class="hello-nav-label hello-nav-label-mobile"
                          aria-hidden="true">
                        @Text["Layout.ReturnToApplicationShort"]
                    </span>
                </a>
            }
            @if (isAuthenticated)
            {
                @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
                {
                    <a class="hello-nav-item@(isAccountPage ? " active" : string.Empty)"
                       aria-current="@(isAccountPage ? "page" : null)"
                       asp-page="/SkopkaHello/Account/Index">
                        <svg class="hello-nav-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
                        </svg>
                        <span class="hello-nav-label">@Text["Layout.Account"]</span>
                    </a>
                    @if ((UiOptions.EnabledPages & HelloUiPages.Sessions) != 0)
                    {
                        <a class="hello-nav-item@(isSessionsPage ? " active" : string.Empty)"
                           aria-current="@(isSessionsPage ? "page" : null)"
                           asp-page="/SkopkaHello/Account/Sessions">
                            <svg class="hello-nav-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="4" y="5" width="16" height="11" rx="2" />
                                <path d="M9 20h6" />
                                <path d="M12 16v4" />
                            </svg>
                            <span class="hello-nav-label">@Text["Layout.Sessions"]</span>
                        </a>
                    }
                    @if (crossDeviceApprovalAvailable)
                    {
                        <a class="hello-nav-item@(isSignInRequestsPage ? " active" : string.Empty)"
                           aria-current="@(isSignInRequestsPage ? "page" : null)"
                           asp-page="/SkopkaHello/CrossDevice/Requests">
                            <svg class="hello-nav-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" />
                                <path d="M12 13v8" />
                                <path d="m9 18 3 3 3-3" />
                            </svg>
                            <span class="hello-nav-label hello-nav-label-desktop">
                                @Text["Layout.SignInRequests"]
                            </span>
                            <span class="hello-nav-label hello-nav-label-mobile"
                                  aria-hidden="true">
                                @Text["Layout.SignInRequestsShort"]
                            </span>
                        </a>
                    }
                    @if ((UiOptions.EnabledPages & HelloUiPages.ExternalIdentity) != 0
                        && ExternalIdentity.IsConfigured)
                    {
                        <a class="hello-nav-item@(isSignInMethodsPage ? " active" : string.Empty)"
                           aria-current="@(isSignInMethodsPage ? "page" : null)"
                           asp-page="/SkopkaHello/Account/ExternalLogins">
                            <svg class="hello-nav-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <circle cx="8" cy="12" r="4" />
                                <path d="M12 12h9" />
                                <path d="M18 12v3" />
                                <path d="M15 12v2" />
                            </svg>
                            <span class="hello-nav-label hello-nav-label-desktop">
                                @Text["Layout.SignInMethods"]
                            </span>
                            <span class="hello-nav-label hello-nav-label-mobile"
                                  aria-hidden="true">
                                @Text["Layout.SignInMethodsShort"]
                            </span>
                        </a>
                    }
                    <form method="post"
                          asp-page="/SkopkaHello/Account/Index"
                          asp-page-handler="Logout">
                        <button class="hello-link-button hello-nav-item"
                                type="submit">
                            <svg class="hello-nav-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M10 5H5v14h5" />
                                <path d="M13 8l4 4-4 4" />
                                <path d="M17 12H9" />
                            </svg>
                            <span class="hello-nav-label">@Text["Layout.SignOut"]</span>
                        </button>
                    </form>
                }
            }
            else
            {
                @if (!isLoginPage
                    && (UiOptions.EnabledPages & HelloUiPages.Login) != 0)
                {
                    <a class="hello-nav-item"
                       asp-page="/SkopkaHello/Login">
                        <span class="hello-nav-label">@Text["Layout.SignIn"]</span>
                    </a>
                }
                @if (HelloOptions.SelfRegistrationEnabled
                    && (UiOptions.EnabledPages & HelloUiPages.Registration) != 0)
                {
                    <a class="hello-nav-item"
                       asp-page="/SkopkaHello/Register">
                        <span class="hello-nav-label">@Text["Layout.Register"]</span>
                    </a>
                }
            }
        </nav>
    </header>
    <main class="hello-main">
        @if (!String.IsNullOrWhiteSpace(UiOptions.NoticeText))
        {
            <div class="hello-notice">@UiOptions.NoticeText</div>
        }
        @RenderBody()
    </main>
    @if (showLanguageSelector || showLegalLinks)
    {
        <footer class="hello-footer">
            @if (showLegalLinks)
            {
                <nav class="hello-legal-links"
                     aria-label="@Text["Legal.Navigation"]">
                    @if (UiOptions.TermsOfServiceUrl is not null)
                    {
                        <a href="@UiOptions.TermsOfServiceUrl">
                            @Text["Legal.TermsOfService"]
                        </a>
                    }
                    @if (UiOptions.PrivacyPolicyUrl is not null)
                    {
                        <a href="@UiOptions.PrivacyPolicyUrl">
                            @Text["Legal.PrivacyPolicy"]
                        </a>
                    }
                </nav>
            }
            @if (showLanguageSelector)
            {
                <form method="post"
                      action="@(Context.Request.PathBase
                          + HelloRoutes.CulturePath)"
                      asp-antiforgery="true"
                      class="hello-language-form">
                    <label for="hello-culture">
                        @Text["Layout.Language"]
                    </label>
                    <select id="hello-culture" name="culture">
                        @foreach (var culture in
                            UiOptions.Localization.SupportedCultures)
                        {
                            if (String.Equals(
                                culture.Name,
                                System.Globalization.CultureInfo
                                    .CurrentUICulture.Name,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@culture.Name" selected>
                                    @culture.DisplayName
                                </option>
                            }
                            else
                            {
                                <option value="@culture.Name">
                                    @culture.DisplayName
                                </option>
                            }
                        }
                    </select>
                    <input type="hidden"
                           name="returnUrl"
                           value="@(Context.Request.PathBase
                                + Context.Request.Path
                                + Context.Request.QueryString)" />
                    <button class="hello-link-button" type="submit">
                        @Text["Layout.ChangeLanguage"]
                    </button>
                </form>
            }
        </footer>
    }
</body>
</html>
