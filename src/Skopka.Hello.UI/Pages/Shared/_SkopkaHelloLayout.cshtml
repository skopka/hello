@inject IHelloUiExternalApplication ExternalIdentity
@{
    var showLanguageSelector = UiOptions.Localization.Enabled
        && UiOptions.Localization.SupportedCultures.Count > 1;
    var showLegalLinks = UiOptions.TermsOfServiceUrl is not null
        || UiOptions.PrivacyPolicyUrl is not null;
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Skopka.Hello</title>
    @if (UiOptions.BuiltInStylesEnabled)
    {
        <link rel="stylesheet"
              href="@HelloUiDefaults.BuiltInStylesheetPath" />
    }
    @if (UiOptions.CustomCssFilePath is not null)
    {
        <link rel="stylesheet"
              href="@UiOptions.CustomCssRequestPath" />
    }
</head>
<body>
    <header class="hello-header">
        @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
        {
            <a class="hello-brand" asp-page="/SkopkaHello/Index">
                Skopka.Hello
            </a>
        }
        else if ((UiOptions.EnabledPages & HelloUiPages.Login) != 0)
        {
            <a class="hello-brand" asp-page="/SkopkaHello/Login">
                Skopka.Hello
            </a>
        }
        else
        {
            <span class="hello-brand">Skopka.Hello</span>
        }
        <nav aria-label="@Text["Layout.AccountNavigation"]">
            @if (UiOptions.ApplicationHomeUrl is not null)
            {
                <a href="@UiOptions.ApplicationHomeUrl">
                    @Text["Layout.ReturnToApplication"]
                </a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
                {
                    <a asp-page="/SkopkaHello/Account/Index">@Text["Layout.Account"]</a>
                    @if ((UiOptions.EnabledPages & HelloUiPages.Sessions) != 0)
                    {
                        <a asp-page="/SkopkaHello/Account/Sessions">@Text["Layout.Sessions"]</a>
                    }
                    @if ((UiOptions.EnabledPages & HelloUiPages.ExternalIdentity) != 0
                        && ExternalIdentity.IsConfigured)
                    {
                        <a asp-page="/SkopkaHello/Account/ExternalLogins">@Text["Layout.SignInMethods"]</a>
                    }
                    <form method="post"
                          asp-page="/SkopkaHello/Account/Index"
                          asp-page-handler="Logout">
                        <button class="hello-link-button" type="submit">
                            @Text["Layout.SignOut"]
                        </button>
                    </form>
                }
            }
            else
            {
                @if ((UiOptions.EnabledPages & HelloUiPages.Login) != 0)
                {
                    <a asp-page="/SkopkaHello/Login">@Text["Layout.SignIn"]</a>
                }
                @if (HelloOptions.SelfRegistrationEnabled
                    && (UiOptions.EnabledPages & HelloUiPages.Registration) != 0)
                {
                    <a asp-page="/SkopkaHello/Register">@Text["Layout.Register"]</a>
                }
            }
        </nav>
    </header>
    <main class="hello-main">
        @if (!String.IsNullOrWhiteSpace(UiOptions.NoticeText))
        {
            <div class="hello-notice">@UiOptions.NoticeText</div>
        }
        @RenderBody()
    </main>
    @if (showLanguageSelector || showLegalLinks)
    {
        <footer class="hello-footer">
            @if (showLegalLinks)
            {
                <nav class="hello-legal-links"
                     aria-label="@Text["Legal.Navigation"]">
                    @if (UiOptions.TermsOfServiceUrl is not null)
                    {
                        <a href="@UiOptions.TermsOfServiceUrl">
                            @Text["Legal.TermsOfService"]
                        </a>
                    }
                    @if (UiOptions.PrivacyPolicyUrl is not null)
                    {
                        <a href="@UiOptions.PrivacyPolicyUrl">
                            @Text["Legal.PrivacyPolicy"]
                        </a>
                    }
                </nav>
            }
            @if (showLanguageSelector)
            {
                <form method="post"
                      action="@(Context.Request.PathBase
                          + HelloRoutes.CulturePath)"
                      asp-antiforgery="true"
                      class="hello-language-form">
                    <label for="hello-culture">
                        @Text["Layout.Language"]
                    </label>
                    <select id="hello-culture" name="culture">
                        @foreach (var culture in
                            UiOptions.Localization.SupportedCultures)
                        {
                            if (String.Equals(
                                culture.Name,
                                System.Globalization.CultureInfo
                                    .CurrentUICulture.Name,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@culture.Name" selected>
                                    @culture.DisplayName
                                </option>
                            }
                            else
                            {
                                <option value="@culture.Name">
                                    @culture.DisplayName
                                </option>
                            }
                        }
                    </select>
                    <input type="hidden"
                           name="returnUrl"
                           value="@(Context.Request.PathBase
                                + Context.Request.Path
                                + Context.Request.QueryString)" />
                    <button class="hello-link-button" type="submit">
                        @Text["Layout.ChangeLanguage"]
                    </button>
                </form>
            }
        </footer>
    }
</body>
</html>
