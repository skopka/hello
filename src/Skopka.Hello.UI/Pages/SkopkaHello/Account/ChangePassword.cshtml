@page
@model ChangePasswordModel
@inject HelloDeliveryOptions DeliveryOptions
@{
    ViewData["Title"] = Text["Common.ChangePassword"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["Security.Eyebrow"]</p>
    <h1>@Text["Common.ChangePassword"]</h1>
    <p class="hello-muted">
        @Text["ChangePassword.Delivery",
            DeliveryOptions.VerificationChannel == HelloDeliveryChannel.Sms
                ? Text["Field.PhoneNumber"]
                : Text["Field.EmailAddress"]]
    </p>

    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (!Model.CodeRequested)
    {
        @if (Model.RestartRequired)
        {
            <p class="hello-status" role="status">
                @Text["ChangePassword.RestartRequired"]
            </p>
        }

        <form method="post"
              asp-page-handler="RequestCode"
              class="hello-form">
            <button class="hello-button" type="submit">
                @Text["Common.SendVerificationCode"]
            </button>
        </form>
    }
    else
    {
        <p class="hello-status" role="status">
            @Text["ChangePassword.CodeAccepted"]
            @if (Model.CodeExpiresAt is not null)
            {
                <span>
                    @Text["ChangePassword.ExpiresAtUtc",
                        Model.CodeExpiresAt.Value
                            .ToUniversalTime()
                            .ToString("g")]
                </span>
            }
        </p>

        <form method="post"
              asp-page-handler="Change"
              class="hello-form">
            <input asp-for="Input.ChallengeId" type="hidden" />

            <label asp-for="Input.VerificationCode">@Text["Field.VerificationCode"]</label>
            <input asp-for="Input.VerificationCode"
                   autocomplete="one-time-code"
                   inputmode="numeric" />
            <span asp-validation-for="Input.VerificationCode"
                  class="hello-field-error"></span>

            <label asp-for="Input.CurrentPassword">@Text["Field.CurrentPassword"]</label>
            <input asp-for="Input.CurrentPassword"
                   autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword"
                  class="hello-field-error"></span>

            <label asp-for="Input.NewPassword">@Text["Field.NewPassword"]</label>
            <input asp-for="Input.NewPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"
                  class="hello-field-error"></span>

            <label asp-for="Input.ConfirmPassword">@Text["Field.ConfirmPassword"]</label>
            <input asp-for="Input.ConfirmPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                @Text["ChangePassword.Action"]
            </button>
        </form>

        <form method="post"
              asp-page-handler="RequestCode"
              class="hello-form">
            <button class="hello-button hello-button-secondary"
                    type="submit">
                @Text["Common.SendNewCode"]
            </button>
        </form>
    }

    <p class="hello-card-footer">
        <a asp-page="/SkopkaHello/Account/Index">@Text["Common.BackToAccount"]</a>
    </p>
</section>
