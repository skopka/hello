@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = Text["Account.ExternalSignInMethods"];
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">@Text["Security.Eyebrow"]</p>
    <h1>@Text["Account.ExternalSignInMethods"]</h1>
    <p class="hello-muted">
        @Text["ExternalLogins.Instructions"]
    </p>
</section>

<section class="hello-card">
    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (Model.ExternalError)
    {
        <p class="hello-status hello-status-error" role="alert">
            @Text["ExternalLogins.ExternalError"]
        </p>
    }

    @if (Model.ChallengeRestarted)
    {
        <p class="hello-status" role="status">
            @Text["ExternalLogins.ChallengeRestarted"]
        </p>
    }

    @if (Model.Changed == "linked")
    {
        <p class="hello-status" role="status">
            @Text["ExternalLogins.Linked"]
        </p>
    }
    else if (Model.Changed == "unlinked")
    {
        <p class="hello-status" role="status">
            @Text["ExternalLogins.Unlinked"]
        </p>
    }

    <h2>@Text["ExternalLogins.LinkedProviders"]</h2>
    @if (Model.LinkedProviders.Count == 0)
    {
        <p class="hello-muted">@Text["ExternalLogins.NoneLinked"]</p>
    }
    else
    {
        <div class="hello-provider-list" data-hello-linked-providers>
            @foreach (var provider in Model.LinkedProviders)
            {
                <article class="hello-provider">
                    <div>
                        <h3>@provider.DisplayName</h3>
                        <p>
                            @Text["ExternalLogins.LinkedAtUtc",
                                provider.LinkedAt
                                    .ToUniversalTime()
                                    .ToString("g")]
                            @if (!provider.Enabled)
                            {
                                <span class="hello-badge">@Text["ExternalLogins.Disabled"]</span>
                            }
                        </p>
                    </div>
                    @if (provider.CanUnlink)
                    {
                        <form method="post"
                              asp-page-handler="RequestUnlinkCode">
                            <button class="hello-button hello-button-danger"
                                    type="submit"
                                    name="providerId"
                                    value="@provider.ProviderId">
                                @Text["Common.Remove"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="hello-muted">
                            @Text["ExternalLogins.CannotRemove"]
                        </span>
                    }
                </article>
            }
        </div>
    }

    @if (Model.Providers.Any(provider => !Model.IsLinked(provider.Id)))
    {
        <h2 class="hello-section-heading">@Text["ExternalLogins.AddProvider"]</h2>
        <div class="hello-actions hello-provider-actions"
             data-hello-available-providers>
            @foreach (var provider in Model.Providers)
            {
                @if (!Model.IsLinked(provider.Id))
                {
                    <form method="post" asp-page-handler="Link">
                        <button class="hello-button hello-button-secondary hello-provider-button"
                                type="submit"
                                name="providerId"
                                value="@provider.Id"
                                data-hello-provider="@provider.Id">
                            @Text["ExternalLogins.LinkProviderName", provider.DisplayName]
                        </button>
                    </form>
                }
            }
        </div>
    }

    @if (Model.PendingOperation is not null)
    {
        <div class="hello-step-up" data-hello-step-up>
            <h2>@Text["ExternalLogins.ConfirmChange"]</h2>
            @if (!Model.CodeRequested && Model.PendingOperation == "link")
            {
                <p class="hello-muted">
                    @Text["ExternalLogins.IdentityFrom"]
                    <strong>@(Model.PendingProvider?.DisplayName
                        ?? Text["ExternalLogins.ProviderFallback"])</strong>
                    @Text["ExternalLogins.RequestVerificationBeforeLink"]
                </p>
                <form method="post"
                      asp-page-handler="RequestLinkCode"
                      class="hello-form">
                    <button class="hello-button" type="submit">
                        @Text["Common.SendVerificationCode"]
                    </button>
                </form>
            }
            else
            {
                <p class="hello-status" role="status">
                    @(Model.VerificationChannel == HelloDeliveryChannel.Authenticator
                        ? Text["Security.AuthenticatorStepUp"]
                        : Text["ExternalLogins.CodeSent"])
                    @if (Model.CodeExpiresAt is not null)
                    {
                        <span>
                            @Text["ChangePassword.ExpiresAtUtc",
                                Model.CodeExpiresAt.Value
                                    .ToUniversalTime()
                                    .ToString("g")]
                        </span>
                    }
                </p>
                <form method="post"
                      asp-page-handler="@(Model.PendingOperation == "link" ? "CompleteLink" : "CompleteUnlink")"
                      class="hello-form">
                    <input asp-for="Input.DeliveryChannel" type="hidden" />
                    <label asp-for="Input.VerificationCode">@Text["Field.VerificationCode"]</label>
                    <input asp-for="Input.VerificationCode"
                           autocomplete="one-time-code"
                           inputmode="@(Model.VerificationChannel == HelloDeliveryChannel.Authenticator ? "text" : "numeric")" />
                    <span asp-validation-for="Input.VerificationCode"
                          class="hello-field-error"></span>
                    <button class="hello-button" type="submit">
                        @(Model.PendingOperation == "link"
                            ? Text["ExternalLogins.LinkProvider"]
                            : Text["ExternalLogins.RemoveProvider"])
                    </button>
                </form>
            }

            <form method="post" asp-page-handler="CancelPending">
                <button class="hello-link-button" type="submit">
                    @Text["ExternalLogins.CancelChange"]
                </button>
            </form>
        </div>
    }

    <p class="hello-card-footer">
        <a asp-page="/SkopkaHello/Account/Index">@Text["Common.BackToAccount"]</a>
    </p>
</section>
