@page
@model AccountModel
@inject IHelloUiExternalApplication ExternalIdentity
@{
    ViewData["Title"] = "Account";
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">Account</p>
    <h1>Hello, @Model.DisplayName</h1>
    <p class="hello-muted">
        This page is authenticated by a protected browser session backed by
        Skopka.Identity.
    </p>
</section>

<section class="hello-card">
    <h2>Profile</h2>
    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (Model.EmailConfirmationRequested)
    {
        <p class="hello-status" role="status">
            The request was accepted. If the address still needs
            confirmation, delivery of a new link will be attempted.
        </p>
    }

    @if (Model.PhoneConfirmationRequested)
    {
        <p class="hello-status" role="status">
            The request was accepted. If the phone still needs
            confirmation, delivery of a new SMS will be attempted.
        </p>
    }

    <dl class="hello-details">
        <div>
            <dt>User ID</dt>
            <dd><code>@Model.UserId</code></dd>
        </div>
        <div>
            <dt>User name</dt>
            <dd>@(Model.UserName ?? "Not set")</dd>
        </div>
        <div>
            <dt>Email</dt>
            <dd>@(Model.Email ?? "Not set")</dd>
        </div>
        <div>
            <dt>Email status</dt>
            <dd>@(Model.EmailConfirmed ? "Confirmed" : "Not confirmed")</dd>
        </div>
        <div>
            <dt>Phone</dt>
            <dd>@(Model.Phone ?? "Not set")</dd>
        </div>
        <div>
            <dt>Phone status</dt>
            <dd>@(Model.PhoneConfirmed ? "Confirmed" : "Not confirmed")</dd>
        </div>
    </dl>

    <div class="hello-actions">
        <a class="hello-button"
           asp-page="/SkopkaHello/Account/Sessions">
            Manage sessions
        </a>
        <a class="hello-button hello-button-secondary"
           asp-page="/SkopkaHello/Account/ChangePassword">
            Change password
        </a>
        @if (ExternalIdentity.IsConfigured)
        {
            <a class="hello-button hello-button-secondary"
               asp-page="/SkopkaHello/Account/ExternalLogins">
                External sign-in methods
            </a>
        }
        <form method="post" asp-page-handler="Logout">
            <button class="hello-button hello-button-secondary"
                    type="submit">
                Sign out
            </button>
        </form>
        @if (!Model.EmailConfirmed && Model.Email is not null)
        {
            <form method="post"
                  asp-page-handler="RequestEmailConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    Send confirmation link
                </button>
            </form>
        }
        @if (!Model.PhoneConfirmed && Model.Phone is not null)
        {
            <form method="post"
                  asp-page-handler="RequestPhoneConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    Send phone confirmation
                </button>
            </form>
        }
    </div>
</section>
