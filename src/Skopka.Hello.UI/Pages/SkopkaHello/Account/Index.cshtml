@page
@model AccountModel
@inject IHelloUiExternalApplication ExternalIdentity
@{
    ViewData["Title"] = "Account";
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">Account</p>
    <h1>Hello, @Model.DisplayName</h1>
    <p class="hello-muted">
        This page is authenticated by a protected browser session backed by
        Skopka.Identity.
    </p>
</section>

<section class="hello-card">
    <h2>Profile</h2>
    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (Model.EmailConfirmationRequested)
    {
        <p class="hello-status" role="status">
            The request was accepted. If the address still needs
            confirmation, delivery of a new link will be attempted.
        </p>
    }

    @if (Model.PhoneConfirmationRequested)
    {
        <p class="hello-status" role="status">
            The request was accepted. If the phone still needs
            confirmation, delivery of a new SMS will be attempted.
        </p>
    }

    <dl class="hello-details">
        <div>
            <dt>User ID</dt>
            <dd><code>@Model.UserId</code></dd>
        </div>
        <div>
            <dt>User name</dt>
            <dd>@(Model.UserName ?? "Not set")</dd>
        </div>
        <div>
            <dt>Email</dt>
            <dd>@(Model.Email ?? "Not set")</dd>
        </div>
        <div>
            <dt>Email status</dt>
            <dd>@(Model.EmailConfirmed ? "Confirmed" : "Not confirmed")</dd>
        </div>
        <div>
            <dt>Phone</dt>
            <dd>@(Model.Phone ?? "Not set")</dd>
        </div>
        <div>
            <dt>Phone status</dt>
            <dd>@(Model.PhoneConfirmed ? "Confirmed" : "Not confirmed")</dd>
        </div>
    </dl>

    <h2>Sign-in handles</h2>
    <p class="hello-muted">
        Changing an email address or phone number resets its confirmation.
        Leave an optional value empty to remove it. Password sign-in must
        retain at least one user name, email address or phone number.
    </p>

    <form method="post"
          asp-page-handler="ChangeUserName"
          class="hello-form">
        <input asp-for="UserNameInput.ExpectedVersion" type="hidden" />
        <label asp-for="UserNameInput.UserName"></label>
        <input asp-for="UserNameInput.UserName"
               autocomplete="username" />
        <span asp-validation-for="UserNameInput.UserName"
              class="hello-field-error"></span>
        <button class="hello-button hello-button-secondary"
                type="submit">
            Change user name
        </button>
    </form>

    <form method="post"
          asp-page-handler="ChangeEmail"
          class="hello-form">
        <input asp-for="EmailInput.ExpectedVersion" type="hidden" />
        <label asp-for="EmailInput.Email"></label>
        <input asp-for="EmailInput.Email" autocomplete="email" />
        <span asp-validation-for="EmailInput.Email"
              class="hello-field-error"></span>
        <button class="hello-button hello-button-secondary"
                type="submit">
            Change email
        </button>
    </form>

    <form method="post"
          asp-page-handler="ChangePhone"
          class="hello-form">
        <input asp-for="PhoneInput.ExpectedVersion" type="hidden" />
        <label asp-for="PhoneInput.Phone"></label>
        <input asp-for="PhoneInput.Phone" autocomplete="tel" />
        <span asp-validation-for="PhoneInput.Phone"
              class="hello-field-error"></span>
        <button class="hello-button hello-button-secondary"
                type="submit">
            Change phone
        </button>
    </form>

    @if (Model.ProfileFields.Count > 0)
    {
        <h2>Editable profile</h2>
        <form method="post"
              asp-page-handler="UpdateProfile"
              class="hello-form">
            <input asp-for="ProfileExpectedVersion" type="hidden" />
            @foreach (var field in Model.ProfileFields)
            {
                var fieldId = $"hello-profile-{field.Name}";
                <label for="@fieldId">@field.Label</label>
                <input id="@fieldId"
                       name="ProfileValues[@field.Name]"
                       value="@field.Value"
                       type="@field.InputType"
                       autocomplete="@field.AutoComplete"
                       maxlength="@field.MaximumLength"
                       required="@field.Required" />
            }
            <button class="hello-button hello-button-secondary"
                    type="submit">
                Update profile
            </button>
        </form>
    }

    <div class="hello-actions">
        @if ((UiOptions.EnabledPages & HelloUiPages.Sessions) != 0)
        {
            <a class="hello-button"
               asp-page="/SkopkaHello/Account/Sessions">
                Manage sessions
            </a>
        }
        @if ((UiOptions.EnabledPages & HelloUiPages.AccountSecurity) != 0)
        {
            <a class="hello-button hello-button-secondary"
               asp-page="/SkopkaHello/Account/Security">
                Credentials and deletion
            </a>
        }
        @if ((UiOptions.EnabledPages & HelloUiPages.ExternalIdentity) != 0
            && ExternalIdentity.IsConfigured)
        {
            <a class="hello-button hello-button-secondary"
               asp-page="/SkopkaHello/Account/ExternalLogins">
                External sign-in methods
            </a>
        }
        <form method="post" asp-page-handler="Logout">
            <button class="hello-button hello-button-secondary"
                    type="submit">
                Sign out
            </button>
        </form>
        @if ((UiOptions.EnabledPages & HelloUiPages.ContactConfirmation) != 0
            && !Model.EmailConfirmed
            && Model.Email is not null)
        {
            <form method="post"
                  asp-page-handler="RequestEmailConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    Send confirmation link
                </button>
            </form>
        }
        @if ((UiOptions.EnabledPages & HelloUiPages.ContactConfirmation) != 0
            && !Model.PhoneConfirmed
            && Model.Phone is not null)
        {
            <form method="post"
                  asp-page-handler="RequestPhoneConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    Send phone confirmation
                </button>
            </form>
        }
    </div>
</section>
