@page
@inject HelloUiSite Site
@model AccountModel
@inject IHelloUiExternalApplication ExternalIdentity
@inject IHelloUiApplication HelloApplication
@{
    ViewData["Title"] = Text["Layout.Account"];
    var crossDeviceApprovalAvailable =
        await HelloUiCrossDeviceApprovalAvailability.IsAvailableAsync(
            ViewContext.HttpContext,
            HelloApplication,
            ViewContext.HttpContext.RequestAborted);
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">@Text["Layout.Account"]</p>
    <h1>@Text["Account.Greeting", Model.DisplayName]</h1>
</section>

<section class="hello-card">
    <h2>@Text["Account.Profile"]</h2>
    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    @if (Model.EmailConfirmationRequested)
    {
        <p class="hello-status" role="status">
            @Text["Account.EmailConfirmationAccepted"]
        </p>
    }

    @if (Model.PhoneConfirmationRequested)
    {
        <p class="hello-status" role="status">
            @Text["Account.PhoneConfirmationAccepted"]
        </p>
    }

    @if (UiOptions.Account.ShowUserId
        || (Model.CanView(HelloAccountArea.UserName) && HelloUiAccountOptions.IsVisible(UiOptions.Account.UserName))
        || (Model.CanView(HelloAccountArea.Email) && HelloUiAccountOptions.IsVisible(UiOptions.Account.Email))
        || (Model.CanView(HelloAccountArea.Phone) && HelloUiAccountOptions.IsVisible(UiOptions.Account.Phone)))
    {
        <dl class="hello-details">
            @if (UiOptions.Account.ShowUserId)
            {
                <div>
                    <dt>@Text["Account.UserId"]</dt>
                    <dd><code>@Model.UserId</code></dd>
                </div>
            }
            @if ((Model.CanView(HelloAccountArea.UserName) && HelloUiAccountOptions.IsVisible(UiOptions.Account.UserName)))
            {
                <div>
                    <dt>@(UiOptions.Account.IsOnlyUserNameEditable
                        ? Text["Field.LoginName"]
                        : Text["Field.UserName"])</dt>
                    <dd>@(Model.UserName ?? Text["Common.NotSet"])</dd>
                </div>
            }
            @if ((Model.CanView(HelloAccountArea.Email) && HelloUiAccountOptions.IsVisible(UiOptions.Account.Email)))
            {
                <div>
                    <dt>@Text["Field.Email"]</dt>
                    <dd>@(Model.Email ?? Text["Common.NotSet"])</dd>
                </div>
            }
            @if (Model.CanView(HelloAccountArea.Email) && Model.EmailConfirmationApplicable)
            {
                <div>
                    <dt>@Text["Account.EmailStatus"]</dt>
                    <dd>@(Model.EmailConfirmed
                        ? Text["Common.Confirmed"]
                        : Text["Common.NotConfirmed"])</dd>
                </div>
            }
            @if ((Model.CanView(HelloAccountArea.Phone) && HelloUiAccountOptions.IsVisible(UiOptions.Account.Phone)))
            {
                <div>
                    <dt>@Text["Field.Phone"]</dt>
                    <dd>@(Model.Phone ?? Text["Common.NotSet"])</dd>
                </div>
                @if (UiOptions.ContactConfirmation.PhoneEnabled)
                {
                    <div>
                        <dt>@Text["Account.PhoneStatus"]</dt>
                        <dd>@(Model.PhoneConfirmed
                            ? Text["Common.Confirmed"]
                            : Text["Common.NotConfirmed"])</dd>
                    </div>
                }
            }
        </dl>
    }

    @if ((Model.CanEdit(HelloAccountArea.UserName) && HelloUiAccountOptions.IsEditable(UiOptions.Account.UserName))
        || (Model.CanEdit(HelloAccountArea.Email) && HelloUiAccountOptions.IsEditable(UiOptions.Account.Email)))
    {
        <h2>@(UiOptions.Account.IsOnlyUserNameEditable
            ? Text["Account.LoginName"]
            : Text["Account.SignInHandles"])</h2>
        <p class="hello-muted">
            @(UiOptions.Account.IsOnlyUserNameEditable
                ? Text["Account.LoginNameDescription"]
                : Text["Account.SignInHandlesDescription"])
        </p>
    }

    @if ((Model.CanEdit(HelloAccountArea.UserName) && HelloUiAccountOptions.IsEditable(UiOptions.Account.UserName)))
    {
        <form method="post"
          asp-page-handler="ChangeUserName"
          class="hello-form">
        <input asp-for="UserNameInput.ExpectedVersion" type="hidden" />
        <label asp-for="UserNameInput.UserName">@(UiOptions.Account.IsOnlyUserNameEditable
            ? Text["Field.LoginName"]
            : Text["Field.UserName"])</label>
        <input asp-for="UserNameInput.UserName"
               autocomplete="username" />
        <span asp-validation-for="UserNameInput.UserName"
              class="hello-field-error"></span>
        <button class="hello-button hello-button-secondary"
                type="submit">
            @Text["Account.ChangeUserName"]
        </button>
        </form>
    }

    @if ((Model.CanEdit(HelloAccountArea.Email) && HelloUiAccountOptions.IsEditable(UiOptions.Account.Email)))
    {
        <form method="post"
          asp-page-handler="ChangeEmail"
          class="hello-form">
        <input asp-for="EmailInput.ExpectedVersion" type="hidden" />
        <label asp-for="EmailInput.Email">@Text["Field.Email"]</label>
        <input asp-for="EmailInput.Email" autocomplete="email" />
        <span asp-validation-for="EmailInput.Email"
              class="hello-field-error"></span>
        <button class="hello-button hello-button-secondary"
                type="submit">
            @Text["Account.ChangeEmail"]
        </button>
        </form>
    }

    @if (Model.PhoneBindingEnabled)
    {
        <section id="phone-binding" aria-labelledby="phone-binding-title">
        <h2 id="phone-binding-title">@(string.IsNullOrWhiteSpace(Model.Phone) ? Text["PhoneBinding.Add"] : Text["PhoneBinding.Change"])</h2>
        @if (Model.PhoneBindingSucceeded)
        {
            <p class="hello-status" role="status">@Text["PhoneBinding.Success"]</p>
        }
        <p>@Text["PhoneBinding.Description"]</p>
        @if (string.IsNullOrEmpty(Model.BindingTicket))
        {
            <form method="post" asp-page-handler="BeginPhoneBinding" class="hello-form">
                <label asp-for="BindingPhone">@Text["Field.Phone"]</label>
                <input asp-for="BindingPhone" type="tel" autocomplete="tel" aria-describedby="binding-phone-error" required />
                <span asp-validation-for="BindingPhone" id="binding-phone-error" class="hello-field-error"></span>
                <button class="hello-button hello-button-secondary" type="submit">@Text["PhoneBinding.RequestCode"]</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="CompletePhoneBinding" class="hello-form">
                <input asp-for="BindingTicket" type="hidden" />
                <label asp-for="BindingCode">@Text["Phone.Code"]</label>
                <input asp-for="BindingCode" inputmode="numeric" autocomplete="one-time-code" aria-describedby="binding-code-error" required />
                <span asp-validation-for="BindingCode" id="binding-code-error" class="hello-field-error" role="alert"></span>
                <button class="hello-button hello-button-secondary" type="submit">@Text["Phone.VerifyCode"]</button>
                <a asp-page="/SkopkaHello/Account/Index" asp-fragment="phone-binding"
                   class="hello-button hello-button-secondary">@Text["PhoneBinding.Cancel"]</a>
            </form>
        }
        </section>
    }

    @if (Model.CanView(HelloAccountArea.Profile) && Model.ProfileFields.Count > 0)
    {
        <h2>@Text["Account.EditableProfile"]</h2>
        <form method="post"
              asp-page-handler="UpdateProfile"
              class="hello-form">
            <input asp-for="ProfileExpectedVersion" type="hidden" />
            @foreach (var field in Model.ProfileFields)
            {
                var fieldId = $"hello-profile-{field.Name}";
                var fieldKey = $"ProfileValues[{field.Name}]";
                var hintId = string.IsNullOrWhiteSpace(field.Hint)
                    ? null
                    : $"{fieldId}-hint";
                <label for="@fieldId">@field.Label</label>
                <input id="@fieldId"
                       name="@fieldKey"
                       value="@field.Value"
                       type="@field.InputType"
                       autocomplete="@field.AutoComplete"
                       maxlength="@field.MaximumLength"
                       required="@(field.Required && !field.ReadOnly)"
                       disabled="@field.ReadOnly"
                       aria-describedby="@hintId" />
                @if (hintId is not null)
                {
                    <span id="@hintId" class="hello-field-hint">@field.Hint</span>
                }
                @if (ViewData.ModelState.TryGetValue(
                    fieldKey,
                    out var fieldState))
                {
                    foreach (var error in fieldState.Errors)
                    {
                        <span class="hello-field-error">
                            @error.ErrorMessage
                        </span>
                    }
                }
            }
            @if (Model.CanEdit(HelloAccountArea.Profile) && Model.ProfileFields.Any(field => !field.ReadOnly))
            {
                <button class="hello-button hello-button-secondary" type="submit">
                    @Text["Account.UpdateProfile"]
                </button>
            }
        </form>
    }

    <div class="hello-actions">
        @if (UiOptions.AccountSwitching.Enabled)
        {
            <a class="hello-button"
               asp-page="/SkopkaHello/Accounts">
                @Text["Account.SwitchAccount"]
            </a>
        }
        @if (Site.IsEnabled(HelloUiPages.Sessions))
        {
            <a class="hello-button"
               asp-page="/SkopkaHello/Account/Sessions">
                @Text["Account.ManageSessions"]
            </a>
        }
        @if (Site.IsEnabled(HelloUiPages.AccountSecurity))
        {
            <a class="hello-button hello-button-secondary"
               asp-page="/SkopkaHello/Account/Security">
                @Text["Account.CredentialsAndDeletion"]
            </a>
        }
        @if (crossDeviceApprovalAvailable)
        {
            <a class="hello-button hello-button-secondary"
               asp-page="/SkopkaHello/CrossDevice/Requests">
                @Text["Account.SignInRequests"]
            </a>
        }
        @if (Site.IsEnabled(HelloUiPages.ExternalIdentity)
            && Site.Current?.ExternalSignInEnabled == true
            && ExternalIdentity.IsConfigured)
        {
            <a class="hello-button hello-button-secondary"
               asp-page="/SkopkaHello/Account/ExternalLogins">
                @Text["Account.ExternalSignInMethods"]
            </a>
        }
        <form method="post" asp-page-handler="Logout">
            <button class="hello-button hello-button-secondary"
                    type="submit">
                @Text["Layout.SignOut"]
            </button>
        </form>
        @if (Site.IsEnabled(HelloUiPages.ContactConfirmation)
            && Model.CanView(HelloAccountArea.Email) && Model.EmailConfirmationRequired)
        {
            <form method="post"
                  asp-page-handler="RequestEmailConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    @Text["Common.SendConfirmationLink"]
                </button>
            </form>
        }
        @if (Site.IsEnabled(HelloUiPages.ContactConfirmation)
            && Model.CanView(HelloAccountArea.Phone) && Model.PhoneConfirmationRequired)
        {
            <form method="post"
                  asp-page-handler="RequestPhoneConfirmation">
                <button class="hello-button hello-button-secondary"
                        type="submit">
                    @Text["Account.SendPhoneConfirmation"]
                </button>
            </form>
        }
    </div>
</section>
