@page
@model SessionsModel
@{
    ViewData["Title"] = Text["Layout.Sessions"];
}

<section class="hello-page-heading">
    <p class="hello-eyebrow">@Text["Sessions.Eyebrow"]</p>
    <h1>@Text["Sessions.Title"]</h1>
    <p class="hello-muted">
        @Text["Sessions.Instructions"]
    </p>
</section>

<div asp-validation-summary="ModelOnly"
     class="hello-validation"
     role="alert"></div>

@if (Model.Sessions.Count == 0)
{
    <section class="hello-card">
        <p>@Text["Sessions.None"]</p>
    </section>
}
else
{
    <div class="hello-session-list">
        @foreach (var session in Model.Sessions)
        {
            <article class="hello-card hello-session">
                <div>
                    <h2>
                        @(session.ClientName ?? Text["Sessions.UnknownClient"])
                        @if (session.SessionId == Model.CurrentSessionId)
                        {
                            <span class="hello-badge">@Text["Sessions.Current"]</span>
                        }
                    </h2>
                    <p>@(session.DeviceName ?? Text["Sessions.UnknownDevice"])</p>
                    <dl class="hello-session-meta">
                        <div>
                            <dt>@Text["Sessions.LastRefreshed"]</dt>
                            <dd>@session.LastRefreshedAt.ToLocalTime()</dd>
                        </div>
                        <div>
                            <dt>@Text["Sessions.Expires"]</dt>
                            <dd>@session.ExpiresAt.ToLocalTime()</dd>
                        </div>
                    </dl>
                </div>
                <form method="post" asp-page-handler="Revoke">
                    <input type="hidden"
                           name="sessionId"
                           value="@session.SessionId" />
                    <button class="hello-button hello-button-danger"
                            type="submit">
                        @Text["Sessions.Revoke"]
                    </button>
                </form>
            </article>
        }
    </div>
}

<form method="post"
      asp-page-handler="LogoutAll"
      class="hello-danger-zone">
    <div>
        <h2>@Text["Sessions.SignOutEverywhere"]</h2>
        <p>@Text["Sessions.SignOutEverywhereDescription"]</p>
    </div>
    <button class="hello-button hello-button-danger" type="submit">
        @Text["Sessions.RevokeAll"]
    </button>
</form>
