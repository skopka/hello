@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = Text["ConfirmEmail.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["ConfirmEmail.Eyebrow"]</p>
    <h1>@Text["ConfirmEmail.Title"]</h1>

    @if (Model.Confirmed)
    {
        <p class="hello-status" role="status">
            @Text["ConfirmEmail.Confirmed"]
        </p>
        <p class="hello-card-footer">
            @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
            {
                <a asp-page="/SkopkaHello/Account/Index">@Text["Common.ContinueToAccount"]</a>
            }
            else
            {
                <a asp-page="/SkopkaHello/Login">@Text["Common.ContinueToSignIn"]</a>
            }
        </p>
    }
    else if (!Model.LinkValid)
    {
        <p class="hello-validation" role="alert">
            @Text["ConfirmEmail.InvalidLink"]
        </p>
    }
    else
    {
        <p class="hello-muted"
           role="status"
           aria-live="polite"
           data-hello-confirmation-status
           data-hello-confirmation-error="@Text["ConfirmEmail.AutomaticFailed"]">
            @Text["ConfirmEmail.AutomaticProgress"]
        </p>

        <form method="post"
              asp-page="/SkopkaHello/ConfirmEmail"
              asp-antiforgery="true"
              class="hello-form"
              data-hello-auto-submit="@(Model.AutoSubmit ? "true" : "false")">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <button class="hello-button" type="submit">
                @Text["ConfirmEmail.Action"]
            </button>

            <noscript>
                <p class="hello-muted">
                    @Text["ConfirmEmail.RequiresJavaScript"]
                </p>
            </noscript>
        </form>

        @if (Model.AutoSubmit)
        {
            <script src="/_content/Skopka.Hello.UI/js/confirm-email.js"
                    defer></script>
        }
    }
</section>
