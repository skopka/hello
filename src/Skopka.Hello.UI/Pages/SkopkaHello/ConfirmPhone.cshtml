@page
@model ConfirmPhoneModel
@{
    ViewData["Title"] = "Confirm phone";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">Phone confirmation</p>
    <h1>Confirm your phone</h1>

    @if (Model.Confirmed)
    {
        <p class="hello-status" role="status">
            Your phone number is confirmed.
        </p>
        <p class="hello-card-footer">
            @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
            {
                <a asp-page="/SkopkaHello/Account/Index">Continue to account</a>
            }
            else
            {
                <a asp-page="/SkopkaHello/Login">Continue to sign in</a>
            }
        </p>
    }
    else if (!Model.LinkValid)
    {
        <p class="hello-validation" role="alert">
            This phone confirmation link is incomplete or invalid.
        </p>
    }
    else
    {
        <p class="hello-muted">
            For safety, opening the link does not change your account.
            Use the button below to confirm the phone number.
        </p>

        <form method="post" class="hello-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Phone" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <button class="hello-button" type="submit">
                Confirm phone
            </button>
        </form>
    }
</section>
