@page
@model ConfirmPhoneModel
@{
    ViewData["Title"] = Text["ConfirmPhone.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["ConfirmPhone.Eyebrow"]</p>
    <h1>@Text["ConfirmPhone.Title"]</h1>

    @if (Model.Confirmed)
    {
        <p class="hello-status" role="status">
            @Text["ConfirmPhone.Confirmed"]
        </p>
        <p class="hello-card-footer">
            @if ((UiOptions.EnabledPages & HelloUiPages.Account) != 0)
            {
                <a asp-page="/SkopkaHello/Account/Index">@Text["Common.ContinueToAccount"]</a>
            }
            else
            {
                <a asp-page="/SkopkaHello/Login">@Text["Common.ContinueToSignIn"]</a>
            }
        </p>
    }
    else if (!Model.LinkValid)
    {
        <p class="hello-validation" role="alert">
            @Text["ConfirmPhone.InvalidLink"]
        </p>
    }
    else
    {
        <p class="hello-muted">
            @Text["ConfirmPhone.Instructions"]
        </p>

        <form method="post" class="hello-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Phone" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <button class="hello-button" type="submit">
                @Text["ConfirmPhone.Action"]
            </button>
        </form>
    }
</section>
