@page
@model ExternalCompleteModel
@{
    ViewData["Title"] = Text["ExternalComplete.PageTitle"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["ExternalComplete.Eyebrow"]</p>
    <h1>@Text["ExternalComplete.Title"]</h1>
    <p class="hello-muted">
        @Text["ExternalComplete.Instructions"]
    </p>

    <div asp-validation-summary="ModelOnly"
         class="hello-validation"
         role="alert"></div>

    <form method="post" class="hello-form">
        <button class="hello-button" type="submit" autofocus>
            @Text["ExternalComplete.Action"]
        </button>
    </form>

    <form method="post"
          asp-page-handler="Cancel"
          class="hello-card-footer">
        <button class="hello-link-button" type="submit">
            @Text["Common.CancelToSignIn"]
        </button>
    </form>
</section>
