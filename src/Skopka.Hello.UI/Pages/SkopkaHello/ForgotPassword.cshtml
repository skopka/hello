@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">Account recovery</p>
    <h1>Reset your password</h1>

    @if (Model.Sent)
    {
        <p class="hello-status" role="status">
            The request was accepted. If an active account uses that
            email address, delivery of a reset link will be attempted.
        </p>
    }
    else
    {
        <p class="hello-muted">
            Enter the email address associated with your account.
        </p>

        <form method="post" class="hello-form">
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email"
                   autocomplete="email"
                   inputmode="email" />
            <span asp-validation-for="Input.Email"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                Send reset link
            </button>
        </form>
    }

    <p class="hello-card-footer">
        <a asp-page="/SkopkaHello/Login">Back to sign in</a>
    </p>
</section>
