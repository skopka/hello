@page
@model LoginModel
@{
    ViewData["Title"] = Text["Login.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["Login.Eyebrow"]</p>
    <h1>@Text["Login.Title"]</h1>

    @if (Model.Registered)
    {
        <p class="hello-status" role="status">
            @Text["Login.Registered"]
        </p>
    }

    @if (Model.PasswordReset)
    {
        <p class="hello-status" role="status">
            @Text["Login.PasswordReset"]
        </p>
    }

    @if (Model.ExternalError)
    {
        <p class="hello-status hello-status-error" role="alert">
            @Text["Login.ExternalError"]
        </p>
    }

    @if (Model.AccountChangeRestarted)
    {
        <p class="hello-status" role="status">
            @Text["Login.AccountChangeRestarted"]
        </p>
    }

    @if (Model.PasswordChangedSessionCleanup)
    {
        <p class="hello-status" role="status">
            @Text["Login.PasswordChangedSessionCleanup"]
        </p>
    }

    @if (Model.AccountDeleted)
    {
        <p class="hello-status" role="status">
            @Text["Login.AccountDeleted"]
        </p>
    }
    else if (Model.SecurityChanged)
    {
        <p class="hello-status" role="status">
            @Text["Login.SecurityChanged"]
        </p>
    }

    @if (Model.RolesChanged)
    {
        <p class="hello-status" role="status">
            @Text["Login.RolesChanged"]
        </p>
    }

    @if (Model.RolesChangedSessionCleanup)
    {
        <p class="hello-status" role="status">
            @Text["Login.RolesChangedSessionCleanup"]
        </p>
    }

    @if (Model.AccountSecurityChangedSessionCleanup)
    {
        <p class="hello-status" role="status">
            @Text["Login.AccountSecurityChangedSessionCleanup"]
        </p>
    }

    @if ((UiOptions.EnabledPages & HelloUiPages.ExternalIdentity) != 0
        && Model.ExternalProviders.Count > 0)
    {
        <div class="hello-external-providers"
             data-hello-external-providers>
            @foreach (var provider in Model.ExternalProviders)
            {
                <form method="post" asp-page-handler="External">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <button class="hello-button hello-button-secondary hello-provider-button"
                            type="submit"
                            name="providerId"
                            value="@provider.Id"
                            data-hello-provider="@provider.Id">
                        @Text["Login.ContinueWith", provider.DisplayName]
                    </button>
                </form>
            }
        </div>
        <div class="hello-divider" role="separator">
            <span>@(Model.PasswordEnabled
                ? Text["Login.OrUsePassword"]
                : Text["Phone.OrUsePhone"])</span>
        </div>
    }

    @if (Model.PhoneEnabled)
    {
        <div class="hello-phone-login">
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation" role="alert"></div>
            @if (!string.IsNullOrEmpty(Model.Phone.RegistrationToken))
            {
                <form method="post" asp-page-handler="PhoneRegister"
                      class="hello-form">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <input asp-for="Phone.RegistrationToken" type="hidden" />
                    <p>@Text["Phone.RegistrationPrompt"]</p>
                    <label asp-for="Phone.DisplayName">@Text["Field.DisplayName"]</label>
                    <input asp-for="Phone.DisplayName" autocomplete="name" />
                    @if (UiOptions.Registration.IsVisible(HelloUiRegistrationField.Locale))
                    {
                        <label asp-for="Phone.Locale">@Text["Field.Locale"]</label>
                        <input asp-for="Phone.Locale" autocomplete="language"
                               required="@UiOptions.Registration.IsRequired(HelloUiRegistrationField.Locale)" />
                        <span asp-validation-for="Phone.Locale" class="hello-field-error"></span>
                    }
                    @if (UiOptions.TermsOfServiceUrl is not null
                        || UiOptions.PrivacyPolicyUrl is not null)
                    {
                        <fieldset class="hello-legal-consents">
                            <partial name="/Pages/Shared/_SkopkaHelloLegalNotice.cshtml" />
                            @if (UiOptions.TermsOfServiceUrl is not null)
                            {
                                <div class="hello-legal-consent">
                                    <input asp-for="Phone.AcceptTermsOfService"
                                           required />
                                    <label asp-for="Phone.AcceptTermsOfService">
                                        @Text["Legal.AcceptTermsOfServicePrefix"]
                                        <a href="@UiOptions.TermsOfServiceUrl">
                                            @Text["Legal.TermsOfService"]
                                        </a>.
                                    </label>
                                    <span asp-validation-for="Phone.AcceptTermsOfService"
                                          class="hello-field-error hello-legal-consent-error"></span>
                                </div>
                            }
                            @if (UiOptions.PrivacyPolicyUrl is not null)
                            {
                                <div class="hello-legal-consent">
                                    <input asp-for="Phone.AcceptPrivacyPolicy"
                                           required />
                                    <label asp-for="Phone.AcceptPrivacyPolicy">
                                        @Text["Legal.AcceptPrivacyPolicyPrefix"]
                                        <a href="@UiOptions.PrivacyPolicyUrl">
                                            @Text["Legal.PrivacyPolicy"]
                                        </a>.
                                    </label>
                                    <span asp-validation-for="Phone.AcceptPrivacyPolicy"
                                          class="hello-field-error hello-legal-consent-error"></span>
                                </div>
                            }
                        </fieldset>
                    }

                    <button class="hello-button" type="submit">
                        @Text["Phone.CompleteRegistration"]
                    </button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="PhoneRequest"
                      class="hello-form">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <label asp-for="Phone.PhoneNumber">@Text["Phone.Number"]</label>
                    <input asp-for="Phone.PhoneNumber" type="tel"
                           autocomplete="tel" placeholder="+79991234567" />
                    <span asp-validation-for="Phone.PhoneNumber" class="hello-field-error"></span>
                    <button class="hello-button hello-button-secondary"
                            type="submit"
                            data-phone-resend
                            data-countdown-label="@Text["Phone.ResendIn"]"
                            data-retry-seconds="@Model.Phone.RetryAfterSeconds">
                        @(Model.Phone.RequestId == Guid.Empty
                            ? Text["Phone.RequestCode"]
                            : Text["Phone.ResendCode"])
                    </button>
                </form>
                @if (Model.Phone.RequestId != Guid.Empty)
                {
                    <form method="post" asp-page-handler="PhoneVerify"
                          class="hello-form">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="Phone.RequestId" type="hidden" />
                        <input asp-for="Phone.PhoneNumber" type="hidden" />
                        <label asp-for="Phone.Code">@Text["Phone.Code"]</label>
                        <input asp-for="Phone.Code" inputmode="numeric"
                               autocomplete="one-time-code" />
                        <button class="hello-button" type="submit">
                            @Text["Phone.VerifyCode"]
                        </button>
                    </form>
                }
            }
        </div>
    }

    @if (Model.PasswordEnabled)
    {
    <form method="post" class="hello-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly"
             class="hello-validation"
             role="alert"></div>

        <label asp-for="Input.Login">@(HelloOptions.PasswordLoginHandle
            == Skopka.Identity.Authentication.PasswordLoginHandle.UserName
                ? Text["Field.LoginName"]
                : Text["Field.Login"])</label>
        <input asp-for="Input.Login" autocomplete="username" />
        <span asp-validation-for="Input.Login"
              class="hello-field-error"></span>

        <label asp-for="Input.Password">@Text["Field.Password"]</label>
        <input asp-for="Input.Password"
               autocomplete="current-password" />
        <span asp-validation-for="Input.Password"
              class="hello-field-error"></span>

        @if ((UiOptions.EnabledPages & HelloUiPages.PasswordRecovery) != 0)
        {
            <a class="hello-form-help"
               asp-page="/SkopkaHello/ForgotPassword">
                @Text["Login.ForgotPassword"]
            </a>
        }

        <button class="hello-button" type="submit">
            @Text["Layout.SignIn"]
        </button>
    </form>
    }

    @if (Model.PasskeysEnabled)
    {
        @* Hidden until the page script has seen that this browser can do it.
           A button that opens nothing is worse than no button. *@
        <div data-passkey
             data-ceremony="get"
             data-challenge-url="@Url.Page(null, "PasskeyChallenge")"
             hidden>
            <div class="hello-divider" role="separator">
                <span>@Text["Login.OrUsePasskey"]</span>
            </div>
            <form method="post"
                  asp-page-handler="Passkey"
                  class="hello-form"
                  data-passkey-form>
                <input asp-for="ReturnUrl" type="hidden" />
                <input asp-for="Passkey.Ticket" type="hidden"
                       data-passkey-field="ticket" />
                <input asp-for="Passkey.CredentialId" type="hidden"
                       data-passkey-field="credentialId" />
                <input asp-for="Passkey.ClientDataJson" type="hidden"
                       data-passkey-field="clientDataJson" />
                <input asp-for="Passkey.AuthenticatorData" type="hidden"
                       data-passkey-field="authenticatorData" />
                <input asp-for="Passkey.Signature" type="hidden"
                       data-passkey-field="signature" />
                <button class="hello-button hello-button-secondary"
                        type="button"
                        data-passkey-start>
                    @Text["Login.PasskeyAction"]
                </button>
                <p class="hello-status" role="status" data-passkey-busy hidden>
                    @Text["Login.PasskeyBusy"]
                </p>
                <p class="hello-status hello-status-error" role="alert"
                   data-passkey-error hidden>
                    @Text["Login.PasskeyFailed"]
                </p>
            </form>
        </div>
    }

    @if (Model.CrossDeviceEnabled)
    {
        <div class="hello-divider" role="separator">
            <span>@Text["Login.OrUseAnotherDevice"]</span>
        </div>
        <form method="post"
              asp-page-handler="CrossDevice"
              class="hello-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <button class="hello-button hello-button-secondary"
                    type="submit">
                @Text["Login.CrossDeviceAction"]
            </button>
        </form>
    }

    @if ((HelloOptions.PasswordSignInEnabled
            && HelloOptions.SelfRegistrationEnabled
            && (UiOptions.EnabledPages & HelloUiPages.Registration) != 0)
        || (UiOptions.EnabledPages & HelloUiPages.ContactConfirmation) != 0
            && (UiOptions.ContactConfirmation.EmailEnabled
                || UiOptions.ContactConfirmation.PhoneEnabled))
    {
        <p class="hello-card-footer">
            @if (HelloOptions.PasswordSignInEnabled
                && HelloOptions.SelfRegistrationEnabled
                && (UiOptions.EnabledPages & HelloUiPages.Registration) != 0)
            {
                <span>@Text["Login.NeedAccount"]</span>
                <a asp-page="/SkopkaHello/Register">@Text["Layout.Register"]</a>
                @if ((UiOptions.EnabledPages
                        & HelloUiPages.ContactConfirmation) != 0)
                {
                    <br />
                }
            }
            @if ((UiOptions.EnabledPages & HelloUiPages.ContactConfirmation) != 0
                && UiOptions.ContactConfirmation.EmailEnabled)
            {
                <a asp-page="/SkopkaHello/ResendConfirmation">
                    @Text["Login.ResendEmailConfirmation"]
                </a>
                @if (UiOptions.ContactConfirmation.PhoneEnabled)
                {
                    <br />
                }
            }
            @if ((UiOptions.EnabledPages & HelloUiPages.ContactConfirmation) != 0
                && UiOptions.ContactConfirmation.PhoneEnabled)
            {
                <a asp-page="/SkopkaHello/ResendPhoneConfirmation">
                    @Text["Login.ResendPhoneConfirmation"]
                </a>
            }
        </p>
    }
</section>

@if (Model.PhoneEnabled)
{
    <script src="/_content/Skopka.Hello.UI/js/phone-otp.js" defer></script>
}

@if (Model.PasskeysEnabled)
{
    <script src="/_content/Skopka.Hello.UI/js/passkey.js" defer></script>
}
