@page
@model RegisterModel
@{
    ViewData["Title"] = Text["Register.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["Register.Eyebrow"]</p>
    <h1>@Text["Register.Title"]</h1>
    <p class="hello-muted">
        @Text["Register.Instructions"]
    </p>

    <form method="post" class="hello-form">
        <div asp-validation-summary="ModelOnly"
             class="hello-validation"
             role="alert"></div>

        <label asp-for="Input.DisplayName">@Text["Field.DisplayName"]</label>
        <input asp-for="Input.DisplayName" autocomplete="name" />
        <span asp-validation-for="Input.DisplayName"
              class="hello-field-error"></span>

        <label asp-for="Input.Email">@Text["Field.Email"]</label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email"
              class="hello-field-error"></span>

        <label asp-for="Input.UserName">@Text["Field.UserName"]</label>
        <input asp-for="Input.UserName" autocomplete="username" />
        <span asp-validation-for="Input.UserName"
              class="hello-field-error"></span>

        <label asp-for="Input.Phone">@Text["Field.Phone"]</label>
        <input asp-for="Input.Phone" autocomplete="tel" />
        <span asp-validation-for="Input.Phone"
              class="hello-field-error"></span>

        <label asp-for="Input.Locale">@Text["Field.Locale"]</label>
        <input asp-for="Input.Locale" autocomplete="language" />
        <span asp-validation-for="Input.Locale"
              class="hello-field-error"></span>

        <label asp-for="Input.Password">@Text["Field.Password"]</label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password"
              class="hello-field-error"></span>

        <label asp-for="Input.ConfirmPassword">@Text["Field.ConfirmPassword"]</label>
        <input asp-for="Input.ConfirmPassword"
               autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword"
              class="hello-field-error"></span>

        <button class="hello-button" type="submit">
            @Text["Register.Action"]
        </button>
    </form>

    <p class="hello-card-footer">
        @Text["Register.AlreadyRegistered"]
        <a asp-page="/SkopkaHello/Login">@Text["Layout.SignIn"]</a>
    </p>
</section>
