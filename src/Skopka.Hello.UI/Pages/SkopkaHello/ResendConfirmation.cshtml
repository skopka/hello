@page
@model ResendConfirmationModel
@{
    ViewData["Title"] = Text["ConfirmEmail.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["ConfirmEmail.Eyebrow"]</p>
    <h1>@Text["ResendEmail.Title"]</h1>

    @if (Model.Sent)
    {
        <p class="hello-status" role="status">
            @Text["ResendEmail.Accepted"]
        </p>
    }
    else
    {
        <form method="post" class="hello-form">
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <label asp-for="Input.Email">@Text["Field.Email"]</label>
            <input asp-for="Input.Email"
                   autocomplete="email"
                   inputmode="email" />
            <span asp-validation-for="Input.Email"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                @Text["Common.SendConfirmationLink"]
            </button>
        </form>
    }

    <p class="hello-card-footer">
        <a asp-page="/SkopkaHello/Login">@Text["Common.BackToSignIn"]</a>
    </p>
</section>
