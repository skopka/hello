@page
@model ResendPhoneConfirmationModel
@{
    ViewData["Title"] = Text["ConfirmPhone.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["ConfirmPhone.Eyebrow"]</p>
    <h1>@Text["ResendPhone.Title"]</h1>

    @if (Model.Sent)
    {
        <p class="hello-status" role="status">
            @Text["ResendPhone.Accepted"]
        </p>
    }
    else
    {
        <form method="post" class="hello-form">
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <label asp-for="Input.Phone">@Text["Field.Phone"]</label>
            <input asp-for="Input.Phone"
                   autocomplete="tel"
                   inputmode="tel" />
            <span asp-validation-for="Input.Phone"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                @Text["Common.SendConfirmationSms"]
            </button>
        </form>
    }

    <p class="hello-card-footer">
        <a asp-page="/SkopkaHello/Login">@Text["Common.BackToSignIn"]</a>
    </p>
</section>
