@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">Account recovery</p>
    <h1>Choose a new password</h1>

    @if (!Model.LinkValid)
    {
        <p class="hello-validation" role="alert">
            This password reset link is incomplete or invalid.
        </p>
    }
    else
    {
        <form method="post" class="hello-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <label asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"
                  class="hello-field-error"></span>

            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                Change password
            </button>
        </form>
    }
</section>
