@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Text["ResetPassword.Title"];
}

<section class="hello-card hello-auth-card">
    <p class="hello-eyebrow">@Text["Recovery.Eyebrow"]</p>
    <h1>@Text["ResetPassword.Title"]</h1>

    @if (!Model.LinkValid)
    {
        <p class="hello-validation" role="alert">
            @Text["ResetPassword.InvalidLink"]
        </p>
    }
    else
    {
        <form method="post" class="hello-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="hello-validation"
                 role="alert"></div>

            <label asp-for="Input.NewPassword">@Text["Field.NewPassword"]</label>
            <input asp-for="Input.NewPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"
                  class="hello-field-error"></span>

            <label asp-for="Input.ConfirmPassword">@Text["Field.ConfirmPassword"]</label>
            <input asp-for="Input.ConfirmPassword"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"
                  class="hello-field-error"></span>

            <button class="hello-button" type="submit">
                @Text["Common.ChangePassword"]
            </button>
        </form>
    }
</section>
