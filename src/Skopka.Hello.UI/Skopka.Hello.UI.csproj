<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>Razor Class Library boundary for the optional Skopka.Hello UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Skopka.Hello\Skopka.Hello.csproj" />
    <ProjectReference Include="..\Skopka.Hello.Oidc\Skopka.Hello.Oidc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Localization\Resources\*.json" />
    <EmbeddedResource Include="Localization\Resources\*.json"
                      LogicalName="Skopka.Hello.UI.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
